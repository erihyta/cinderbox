{
	"version": 6,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "win-base",
			"hidden": true,
			"inherits": "base",
			"binaryDir": "$env{LOCALAPPDATA}/cinderbox-build/${sourceDirName}/${presetName}",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {}
		},
		{
			"name": "unix-base",
			"hidden": true,
			"inherits": "base",
			"binaryDir": "$env{HOME}/.cache/cinderbox-build/${sourceDirName}/${presetName}",
			"condition": {
				"type": "notEquals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {}
		},
		{
			"name": "clang-debug",
			"displayName": "Clang Debug (Windows)",
			"inherits": "win-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++",
				"CMAKE_BUILD_TYPE": "Debug",
				"CB_BUILD_GODOT": "OFF"
			}
		},
		{
			"name": "clang-release",
			"displayName": "Clang Release (Windows)",
			"inherits": "win-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++",
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CB_BUILD_GODOT": "ON"
			}
		},
		{
			"name": "gcc-release",
			"displayName": "MinGW GCC Release (Windows)",
			"inherits": "win-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++",
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CB_BUILD_GODOT": "OFF"
			}
		},
		{
			"name": "msvc-release",
			"displayName": "MSVC Release (run from a VS developer prompt)",
			"inherits": "win-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl",
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CB_BUILD_GODOT": "OFF"
			}
		},
		{
			"name": "unix-clang-release",
			"displayName": "Clang Release (Linux/macOS)",
			"inherits": "unix-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++",
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CB_BUILD_GODOT": "ON"
			}
		},
		{
			"name": "unix-gcc-release",
			"displayName": "GCC Release (Linux)",
			"inherits": "unix-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++",
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CB_BUILD_GODOT": "OFF"
			}
		},
		{
			"name": "godot-export",
			"displayName": "Clang Release + Godot template_release (for exported games)",
			"inherits": "win-base",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++",
				"CMAKE_BUILD_TYPE": "Release",
				"CB_BUILD_GODOT": "ON",
				"CB_GODOT_TARGET": "template_release",
				"CB_BUILD_TESTS": "OFF",
				"CB_BUILD_CLIENT": "OFF"
			}
		}
	],
	"buildPresets": [
		{
			"name": "clang-debug",
			"configurePreset": "clang-debug"
		},
		{
			"name": "clang-release",
			"configurePreset": "clang-release"
		},
		{
			"name": "gcc-release",
			"configurePreset": "gcc-release"
		},
		{
			"name": "msvc-release",
			"configurePreset": "msvc-release"
		},
		{
			"name": "unix-clang-release",
			"configurePreset": "unix-clang-release"
		},
		{
			"name": "unix-gcc-release",
			"configurePreset": "unix-gcc-release"
		},
		{
			"name": "godot-export",
			"configurePreset": "godot-export"
		}
	],
	"testPresets": [
		{
			"name": "clang-debug",
			"configurePreset": "clang-debug",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "clang-release",
			"configurePreset": "clang-release",
			"output": {
				"outputOnFailure": true
			}
		}
	]
}