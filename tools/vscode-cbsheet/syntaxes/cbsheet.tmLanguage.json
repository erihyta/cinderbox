{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Cinderbox sheet",
	"scopeName": "source.cbsheet",
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"include": "#string"
		},
		{
			"include": "#block"
		},
		{
			"include": "#declaration"
		},
		{
			"include": "#keyword"
		},
		{
			"include": "#logic"
		},
		{
			"include": "#number"
		},
		{
			"include": "#name"
		},
		{
			"include": "#operator"
		}
	],
	"repository": {
		"comment": {
			"match": "#.*$",
			"name": "comment.line.number-sign.cbsheet"
		},
		"string": {
			"begin": "\"",
			"end": "\"",
			"name": "string.quoted.double.cbsheet"
		},
		"block": {
			"comment": "A block's first word, at the start of a line: what it is, and its name.",
			"match": "^(replace\\s+)?(motion|react|hud|predict|use|show|text|bind)\\b(\\s+[A-Z][A-Za-z0-9_]*)?",
			"captures": {
				"1": {
					"name": "keyword.other.cbsheet"
				},
				"2": {
					"name": "storage.type.cbsheet"
				},
				"3": {
					"name": "entity.name.function.cbsheet"
				}
			}
		},
		"declaration": {
			"match": "^(field|event|action|param|status|tag|let|uses|cbsheet)\\b",
			"name": "storage.modifier.cbsheet"
		},
		"keyword": {
			"match": "\\b(on|while|when|if|else|wait|for|within|or|every|timeout|lasts|cooldown|until|uses|refill|ground|tags|blocked|by|cancels|shared|release|tap|hold|press|item|holder|carrier|owner|change|emit|value|end|apply|find|grab|cast|range|speed|holds|level|bodies|players|first|self|max|turned|look|facing|move|up|world|to|away|toward|at|hit|target|along|turn|impulse|force|kind|velocity|momentum|acceleration|top|ramp|react|link|length|reel|alone|launch|new|carried|lift|ahead|seconds|from|follow|over|break|radius|remove|throw|marks|replace|nothing|vertical|horizontal|all|sphere|box|capsule|ray|as|actor|me|local|create|sound|volume|pitch|jitter|bus|play|set|call|shake|flash|life|chance|after|server|only|known|of|is|active|ready|remaining|timer|int|float|bool|private|key|everyone|hud|text|bind|scene|beam|point|here|attached|steer|strength|down|per|second)\\b",
			"name": "keyword.control.cbsheet"
		},
		"logic": {
			"match": "\\b(and|not|true|false)\\b",
			"name": "keyword.operator.logical.cbsheet"
		},
		"number": {
			"match": "(?<![A-Za-z_.])-?[0-9]+(\\.[0-9]+)?(\\s*(s|m|m/s|deg)\\b)?",
			"name": "constant.numeric.cbsheet"
		},
		"name": {
			"comment": "A mod's name: dotted (brawl.cd_dash, gun.rounds).",
			"match": "\\b[a-z_][a-z0-9_]*(\\.[a-z0-9_]+)+\\b",
			"name": "variable.other.cbsheet"
		},
		"operator": {
			"match": "(==|!=|<=|>=|\\+=|-=|=|<|>|\\+|-|\\*|/|&&|\\|\\||!)",
			"name": "keyword.operator.cbsheet"
		}
	}
}
