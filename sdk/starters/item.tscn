[gd_scene format=3]

; A starter item. This scene is the item: its root says which kind it is, and everything under it
; is how it looks in the hand, put away and lying in the world. Saving it bakes
; items/MODNAME.item.cfg, which the server reads and the game finds this scene by.
;
;   Item        CbItem             the kind (the one the server mod declares), its name on the HUD,
;                                  its mass, its first-person view, numbers for mods (properties)
;   Body        CollisionShape3D   its body when it lies in the world: a box or a sphere
;   Carry       Marker3D           where the carrying hand holds it (the item's carry_grip). Turn it
;                                  to turn the item in the hand
;   OtherHand   Marker3D           for the other hand: the item's other_hand says "as the animations
;                                  have it"; choose "at the marker" and name this one (other_grip)
;                                  to hold it here instead
;   Muzzle      Node3D       a place on the item for what it shows (a flash, a beam, sparks):
;     Used      CbReaction   on "MODNAME.used" of whoever holds it (^^): give it a scene or a sound
;   PredictUse  CbPrediction       your own press shown at once: the cue the server will answer with.
;                                  In the item's scene it speaks for the one in your hand; its
;                                  conditions are the look's copy of the server's rule
;
; The root's own transform is not used by the game. -Z is forward.

[sub_resource type="BoxShape3D" id="Body"]
size = Vector3(0.06, 0.1, 0.3)

[sub_resource type="StandardMaterial3D" id="Mat"]
albedo_color = Color(0.3, 0.33, 0.38, 1)
roughness = 0.6

[sub_resource type="BoxMesh" id="Mesh"]
material = SubResource("Mat")
size = Vector3(0.06, 0.1, 0.3)

[node name="Item" type="CbItem"]
kind = "MODNAME.item"
display_name = "MODNAME"
carry_grip = NodePath("Carry")
other_hand = 3
mass = 1.0

[node name="Body" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.02, -0.08)
shape = SubResource("Body")

[node name="Mesh" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.02, -0.08)
mesh = SubResource("Mesh")

[node name="Carry" type="Marker3D" parent="."]

[node name="OtherHand" type="Marker3D" parent="."]

[node name="Muzzle" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.02, -0.23)

[node name="Used" type="CbReaction" parent="Muzzle"]
event = "MODNAME.used"
subject = NodePath("^^")

[node name="PredictUse" type="CbPrediction" parent="."]
action = "use"
cue = "MODNAME.used"
conditions = PackedStringArray("!combat.dead")
cooldown = 0.2
