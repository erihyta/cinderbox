[node name="AnimationPack" type="CbAnimPack" unique_id=1252277536]
replaces = PackedStringArray("UpperBody")
character_name = "MODNAME.animations"
skeleton_path = NodePath("Model/Armature/Skeleton3D")
animation_player_path = NodePath("Model/AnimationPlayer")
animation_tree_path = NodePath("AnimationTree")
graph_inputs = {
"FullBody/Move/blend_position": "forward_speed"
}
editor_description = "An animation pack: state machines that replace a character's own while the server mod says so (ItemLayers: while an item is held; or SwapLayer).

The AnimationTree is the default one in full: FullBody (the whole body's locomotion), UpperBody over it (spine, arms, head), and UpperBodyBlend, which lays one over the other and has the bone filter.

Replaces lists the layers this pack ships. It is UpperBody: FullBody is here to see your upper body over a walking character, and is not baked. Add FullBody to replace the locomotion too.

UpperBody's Hold plays the placeholder's Idle: put your own clip there. For a use (a shot, a swing), add a state and a transition whose condition is the server mod's event (MODNAME.used), and one back with Switch Mode At End.

Transitions use the game's names: forward_speed, speed, grounded, jumped, airborne_time, state_time, a stance, an event. Move's position comes from Graph Inputs on this node.

Saving this scene bakes it into res://anim/MODNAME.animations/."

