[gd_scene format=3]

; The MODNAME mod's motions: what its players can do besides walking and jumping, with no code.
;
;   Moves   CbMotionSet   the set: the server mod names it (declare.Motions( "MODNAME.moves" ))
;     Rules CbRules       MODNAME_moves.rules: its motions, as lines of text (a push on a press,
;                         with a charge and an event, to start from)
;
; The server mod declares the names used there (the action, the field, the event). Who may use a
; motion is a field its conditions read. Saving this scene bakes it into
; res://motions/MODNAME.moves.cfg; delete the scene and its sheet if the mod has no motions.

[node name="Moves" type="CbMotionSet"]
set_name = "MODNAME.moves"

[node name="Rules" type="CbRules" parent="."]
file = "res://motion_sets/MODNAME_moves.rules"
