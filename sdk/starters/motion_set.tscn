[gd_scene format=3]

; The MODNAME mod's motions: what its players can do besides walking and jumping, with no code.
; Every simulation runs them from the player's own input (the server's, and each client's own
; prediction), so a move starts on the tick of the press. Nothing here waits for the server.
;
;   Use   CbMotion   on "MODNAME_use", while MODNAME.charges > 0: a push along where you walk,
;                    a moment without friction, a charge taken, and the event "MODNAME.moved"
;
; The server mod declares the names used here (the action, the field, the event) and names the
; set: declare.Motions( "MODNAME.moves" ). Who may use a motion is a field its conditions read.
; Select a node to read what each group does. Saving this scene bakes it into
; res://motions/MODNAME.moves.cfg; delete the scene if the mod has no motions.

[node name="Moves" type="CbMotionSet"]
set_name = "MODNAME.moves"

[node name="Use" type="CbMotion" parent="."]
action = "MODNAME_use"
conditions = PackedStringArray("MODNAME.charges > 0")
cooldown = 0.5
impulse = 10.0
replace = 2
duration = 0.2
parameters = {
"friction": 0.0
}
changes = PackedStringArray("MODNAME.charges -= 1")
emits = "MODNAME.moved"
