[gd_scene format=3]

; How the rifle mod looks and sounds, as world reactions. Everything is keyed on names the server's
; mods declared: the "fire" action, "rifle.*" fields and events. $at is who an event is about (the
; shooter), $other the other entity (what was hit). The Gun node says how the "rifle.gun" item
; looks. Being hurt and dying look the same whatever did it: that is the combat mod's look.
;
; The muzzle flash and the tracer are not here: they are the rifle's own, in its scene
; (prefabs/rifle.tscn, under its Muzzle node), so they come from the end of the barrel wherever
; the rifle is turned.
;
; The rifle is automatic: the server fires for as long as "fire" is held, a shot every 0.1 s.
; PredictFire says so to the viewer: while_held, with that time as its cooldown, so "rifle.fired"
; plays for the viewer on the press and again every 0.1 s while the button stays down and there is
; ammo, each one taking a round off the count at once. The server's cues are then their echoes.
; PredictDry is the click of a pull on an empty magazine (the press only: the server clicks once).

[node name="RifleReactions" type="Node3D"]

[node name="PredictFire" type="CbPrediction" parent="."]
action = "fire"
cue = "rifle.fired"
conditions = PackedStringArray("rifle.gun", "rifle.ammo > 0", "!rifle.reloading", "!combat.dead")
cooldown = 0.1
while_held = true
changes = PackedStringArray("rifle.ammo -= 1")

[node name="PredictDry" type="CbPrediction" parent="."]
action = "fire"
cue = "rifle.dry"
conditions = PackedStringArray("rifle.gun", "rifle.ammo == 0", "!rifle.reloading", "!combat.dead")
cooldown = 0.19

[node name="Fired" type="CbReaction" parent="."]
event = "rifle.fired"
subject = NodePath("$at")
place = 4
place_node = NodePath("$at/RightHand")
sound = "res://assets/sfx/rifle_shot.wav"
volume_db = -7.0
pitch_scale = 1.25
pitch_jitter = 0.05
max_distance = 80.0

[node name="Dry" type="CbReaction" parent="."]
event = "rifle.dry"
subject = NodePath("$at")
place = 4
place_node = NodePath("$at/RightHand")
sound = "res://assets/sfx/rifle_dry.wav"
volume_db = -8.0
max_distance = 12.0

[node name="HitSurface" type="CbReaction" parent="."]
event = "rifle.hit"
subject = NodePath("$at")
conditions = PackedStringArray("event.value == 0")
scene = "res://vfx/rifle_spark.tscn"
scene_lifetime = 1.0
place = 1
sound = "res://assets/sfx/rifle_ricochet.wav"
volume_db = -18.0
pitch_jitter = 0.3
max_distance = 30.0

[node name="HitPlayer" type="CbReaction" parent="."]
event = "rifle.hit"
subject = NodePath("$at")
conditions = PackedStringArray("event.value > 0")
scene = "res://vfx/rifle_puff.tscn"
scene_lifetime = 1.0
place = 1
sound = "res://assets/sfx/rifle_body_hit.wav"
volume_db = -10.0
pitch_jitter = 0.15
max_distance = 40.0

[node name="HitMarker" type="CbReaction" parent="."]
event = "rifle.hit"
subject = NodePath("$at")
conditions = PackedStringArray("is_local", "event.value > 0")
place = 4
place_node = NodePath("$at/Head")
sound = "res://assets/sfx/rifle_hit_marker.wav"
volume_db = -8.0

[node name="Reload" type="CbReaction" parent="."]
event = "rifle.reload"
subject = NodePath("$at")
place = 4
place_node = NodePath("$at/RightHand")
sound = "res://assets/sfx/rifle_reload.wav"
volume_db = -10.0
pitch_scale = 0.85
max_distance = 25.0

[node name="Gun" type="CbItemLook" parent="."]
kind = "rifle.gun"
display_name = "Rifle"
scene = "res://prefabs/rifle.tscn"
view_offset = Vector3(0, 0.05, 0.03)
