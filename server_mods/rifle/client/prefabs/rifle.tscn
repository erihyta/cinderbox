[gd_scene format=3]

; The rifle: what a "rifle.gun" looks like, in the hand, on the back and lying in the world.
;
;   Body        CbItemBody   its body when it lies in the world (baked to items/rifle.gun.cfg)
;   Carry       CbGrip       where the carrying hand holds it: the pistol grip
;   OtherHand   CbGrip       the other hand, as animated: the body holds the rifle in the "pistol"
;                            stance, both arms out, and from there a hand cannot reach further up
;                            the rifle. With a rifle stance of its own (the stock at the shoulder),
;                            untick as_animated and put this marker under the handguard.
;   Muzzle      Node3D       the end of the barrel. What a shot shows there is the rifle's own:
;     Flash     CbReaction   on "rifle.fired" of whoever holds it (^^): the flash, under the muzzle
;     Tracer    CbReaction   ... and a beam from the muzzle to where the shot ended
;
; Move the muzzle and the flash and the tracer move with it; turn the Carry marker and the rifle
; turns in the hand, muzzle included. The barrel points along -Z.

[sub_resource type="BoxShape3D" id="Body"]
size = Vector3(0.05, 0.2, 0.8)

[sub_resource type="StandardMaterial3D" id="Metal"]
albedo_color = Color(0.13, 0.14, 0.16, 1)
metallic = 0.6
roughness = 0.4

