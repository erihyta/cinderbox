[gd_scene format=3]

; The dash mod's motion that everyone has: what a player can do besides walking and jumping, with
; no item. Every simulation runs it from the player's own input (the server's, and each client's
; prediction). The dash itself is an item's motion: prefabs/boots.tscn.
;
;   DoubleJump   on "jump", in the air, once until you stand again; emits dash.double_jump.
;                Only where the server allows it (dash.double_jump_on:
;                cb_server --mod-option dash.double_jump=1; off by default)
;     Up         CbImpulse: a jump's speed upward, whatever the fall was
;
; Saving this scene bakes it into res://motions/dash.moves.cfg.

[node name="Moves" type="CbMotionSet"]
set_name = "dash.moves"

[node name="DoubleJump" type="CbMotion" parent="."]
action = "jump"
conditions = PackedStringArray("not grounded", "dash.double_jump_on")
uses = 1
emits = "dash.double_jump"

[node name="Up" type="CbImpulse" parent="DoubleJump"]
frame = 3
speed = 6.5
replace = 1
