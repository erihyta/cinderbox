[gd_scene format=3]

; The dash mod's motions: what its players can do besides walking and jumping. Every simulation
; runs them from the player's own input (the server's, and each client's prediction), so a dash
; starts on the tick of the press. The server mod (server_mods/dash/dash.cpp) declares the names
; used here and gives the charges back.
;
;   Dash         on "dash" (V), while dash.charges > 0: 11 m/s along where you walk, the run's own
;                speed replaced; 0.18 s without friction; a charge is taken; emits dash.started
;   DoubleJump   on "jump", in the air, once until you stand again: a jump's speed upward,
;                whatever the fall was; emits dash.double_jump. Only where the server allows it
;                (dash.double_jump_on: cb_server --mod-option dash.double_jump=1; off by default)
;
; Saving this scene bakes it into res://motions/dash.moves.cfg.

[node name="Moves" type="CbMotionSet"]
set_name = "dash.moves"

[node name="Dash" type="CbMotion" parent="."]
action = "dash"
conditions = PackedStringArray("dash.charges > 0")
cooldown = 0.4
impulse = 11.0
replace = 2
duration = 0.18
parameters = {
"friction": 0.0
}
changes = PackedStringArray("dash.charges -= 1")
emits = "dash.started"

[node name="DoubleJump" type="CbMotion" parent="."]
action = "jump"
conditions = PackedStringArray("not grounded", "dash.double_jump_on")
uses = 1
impulse = 6.5
impulse_frame = 3
replace = 1
emits = "dash.double_jump"
