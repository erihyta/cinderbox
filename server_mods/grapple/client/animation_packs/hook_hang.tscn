[gd_scene format=3]

[ext_resource type="PackedScene" path="res://placeholder/skeleton.tscn" id="1_skeleton"]
[ext_resource type="Animation" path="res://placeholder/clips/Idle.res" id="2_idle"]
[ext_resource type="Animation" path="res://placeholder/clips/Jump.res" id="3_hang"]

[sub_resource type="AnimationLibrary" id="Clips"]
_data = {
&"Idle": ExtResource("2_idle"),
&"Jump": ExtResource("3_hang")
}

[sub_resource type="AnimationNodeAnimation" id="IdleClip"]
animation = &"Idle"

[sub_resource type="AnimationNodeAnimation" id="HangClip"]
animation = &"Jump"

[sub_resource type="AnimationNodeStateMachineTransition" id="StartToIdle"]
advance_mode = 2

[sub_resource type="AnimationNodeStateMachineTransition" id="StartToHang"]
advance_mode = 2

[sub_resource type="AnimationNodeStateMachine" id="FullBody"]
states/Idle/node = SubResource("IdleClip")
states/Idle/position = Vector2(300, 100)
transitions = ["Start", "Idle", SubResource("StartToIdle")]

[sub_resource type="AnimationNodeStateMachineTransition" id="StartToHold"]
advance_mode = 2

[sub_resource type="AnimationNodeStateMachine" id="Hold"]
states/Hold/node = SubResource("IdleClip")
states/Hold/position = Vector2(300, 100)
transitions = ["Start", "Hold", SubResource("StartToHold")]

[sub_resource type="AnimationNodeBlend2" id="HoldBlend"]
filter_enabled = true
filters = ["%Skeleton3D:LeftShoulder", "%Skeleton3D:LeftUpperArm", "%Skeleton3D:LeftLowerArm", "%Skeleton3D:LeftHand", "%Skeleton3D:LeftIndexProximal", "%Skeleton3D:LeftIndexIntermediate", "%Skeleton3D:LeftIndexDistal", "%Skeleton3D:LeftMiddleProximal", "%Skeleton3D:LeftMiddleIntermediate", "%Skeleton3D:LeftMiddleDistal", "%Skeleton3D:LeftLittleProximal", "%Skeleton3D:LeftLittleIntermediate", "%Skeleton3D:LeftLittleDistal", "%Skeleton3D:LeftRingProximal", "%Skeleton3D:LeftRingIntermediate", "%Skeleton3D:LeftRingDistal", "%Skeleton3D:LeftThumbMetacarpal", "%Skeleton3D:LeftThumbProximal", "%Skeleton3D:LeftThumbDistal"]

[sub_resource type="AnimationNodeStateMachine" id="Hang"]
states/Hang/node = SubResource("HangClip")
states/Hang/position = Vector2(300, 100)
transitions = ["Start", "Hang", SubResource("StartToHang")]

[sub_resource type="AnimationNodeBlend2" id="HangBlend"]

[sub_resource type="AnimationNodeBlendTree" id="Tree"]
nodes/output/position = Vector2(700, 160)
nodes/FullBody/node = SubResource("FullBody")
nodes/FullBody/position = Vector2(100, 60)
nodes/Hold/node = SubResource("Hold")
nodes/Hold/position = Vector2(100, 200)
nodes/HoldBlend/node = SubResource("HoldBlend")
nodes/HoldBlend/position = Vector2(340, 100)
nodes/Hang/node = SubResource("Hang")
nodes/Hang/position = Vector2(340, 300)
nodes/HangBlend/node = SubResource("HangBlend")
nodes/HangBlend/position = Vector2(560, 160)
node_connections = [&"HoldBlend", 0, &"FullBody", &"HoldBlend", 1, &"Hold", &"HangBlend", 0, &"HoldBlend", &"HangBlend", 1, &"Hang", &"output", 0, &"HangBlend"]

[node name="HookHangPack" type="CbAnimPack"]
character_name = "grapple.hook_hang"
skeleton_path = NodePath("Skeleton3D")
animation_player_path = NodePath("AnimationPlayer")
animation_tree_path = NodePath("AnimationTree")
replaces = PackedStringArray("Hold", "Hang")
graph_inputs = {
"HangBlend/blend_amount": "motion.grapple.hook.Use",
"HoldBlend/blend_amount": "grapple.hook"
}
editor_description = "Holding the hook, and hanging on its line: the hook's animation pack (the hook's Animation Pack, prefabs/hook.tscn).

Hold and Hang are layers no character has, so each is laid over the body (Hold over the left arm alone: the HoldBlend's bone filter), for as long as its weight says. An item's pack plays such layers while the item is carried, in the hand or not, one overlay slot each.

Hold: \"grapple.hook\" is 1 while the hook is out in a hand (the left: the hook's Hand), so the left arm keeps it at the side, over whatever the right hand's item does with the upper body (the pistol's hold).

Hang: \"motion.grapple.hook.Use\" is 1 while the hook's motion is on (from the throw until the line is let go), over the whole body.

FullBody is here only to see the poses over a standing body in the editor: Replaces names Hold and Hang, so it is not baked.

The clips are the SDK placeholder's (CC0): Idle's left arm for Hold, Jump for Hang. Put others in the AnimationPlayer and in the states to change the poses. Saving this scene bakes anim/grapple.hook_hang/."

[node name="Skeleton3D" parent="." instance=ExtResource("1_skeleton")]
unique_name_in_owner = true

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
root_node = NodePath("..")
libraries/ = SubResource("Clips")

[node name="AnimationTree" type="AnimationTree" parent="."]
active = false
root_node = NodePath("..")
tree_root = SubResource("Tree")
anim_player = NodePath("../AnimationPlayer")
parameters/HoldBlend/blend_amount = 1.0
parameters/HangBlend/blend_amount = 0.0
