[gd_scene format=3]

; The grapple mod's motion: a grappling hook. Every simulation runs it from the player's own input,
; so the throw, the pull and the swing are predicted.
;
;   Hook   on "grapple" (Q), while no hook is out: a line along the look at what is under the
;          crosshair, up to 40 m.
;          It flies at 60 m/s, takes hold, and pulls at 24 m/s per second on a rope that is reeled in
;          at 4 m/s (so you swing, and end up at the point). Pressing Q again lets it go.
;          While it holds: the player is in the air (airborne) whatever is under it, so nothing
;          rubs the pull off and it falls back to the ground when the hook lets go; more air control.
;          It happens only if the line finds something; emits grapple.fired at where it will hold.
;
; Saving this scene bakes it into res://motions/grapple.moves.cfg.

[node name="Moves" type="CbMotionSet"]
set_name = "grapple.moves"

[node name="Hook" type="CbMotion" parent="."]
action = "grapple"
conditions = PackedStringArray("not tethered")
parameters = {
"air_control": 0.6,
"airborne": 1.0
}
tether_range = 40.0
tether_pull = 24.0
tether_reel = 4.0
tether_until = PackedStringArray("pressed.grapple")
emits = "grapple.fired"
