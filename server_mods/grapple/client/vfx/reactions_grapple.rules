# reactions_grapple.tscn's reactions, as a rules sheet (CbRules: docs/looks.md, Rules sheets). Plain paths are
# from the scene's root.

# Fired
on grapple.fired
	subject $at
	at $at/Hip
	sound res://assets/sfx/prop_spawn.wav volume -10 pitch 2 jitter 0.1 range 30

# Hit
on grapple.hooked
	subject $at
	at point
	scene res://vfx/land.tscn life 2
