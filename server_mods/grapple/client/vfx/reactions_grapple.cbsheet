cbsheet 1

# reactions_grapple.tscn's reactions, as a rules sheet (CbRules: docs/looks.md, Rules sheets). Plain paths are
# from the scene's root.

# Fired
react on grapple.fired
	as actor
		at actor/Hip
			sound prop_spawn volume -10 pitch 2 jitter 0.1 range 30

# Hit
react on grapple.hooked
	as actor
		at point
			create land for 2
