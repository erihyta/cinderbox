[gd_scene format=3]

; How the grapple mod looks and sounds. Its reactions are the rules sheet beside it
; (reactions_grapple.rules).
;
;   Rope    CbLinkLook     the rope: grapple_rope.tscn stretched from the waist (the Hip socket: the
;                          line is tied there, the hands stay free) to its
;                          end, while it flies and while it holds
;   Fired   a rule         the throw's sound, at the player. The event comes from the motion, which
;                          the viewer's own simulation runs: yours is heard on the press
;   Hit     a rule         a puff where the hook takes hold, when it does (grapple.hooked, said
;                          by the hook's line at that point)

[node name="GrappleReactions" type="Node3D"]

[node name="Rope" type="CbLinkLook" parent="."]
motion = "grapple.hook/Throw"
scene = "res://vfx/grapple_rope.tscn"
from = "Hip"

[node name="Rules" type="CbRules" parent="."]
file = "res://vfx/reactions_grapple.rules"
