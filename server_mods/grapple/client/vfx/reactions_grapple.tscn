[gd_scene format=3]

; How the grapple mod looks and sounds.
;
;   Rope    CbTetherLook   the rope: grapple_rope.tscn stretched from the right hand to the hook's
;                          end, while it flies and while it holds
;   Fired   CbReaction     the throw's sound, at the player. The event comes from the motion, which
;                          the viewer's own simulation runs: yours is heard on the press
;   Hit     CbReaction     a puff where the hook will hold (the event's point)

[node name="GrappleReactions" type="Node3D"]

[node name="Rope" type="CbTetherLook" parent="."]
motion = "grapple.moves/Hook"
scene = "res://vfx/grapple_rope.tscn"

[node name="Fired" type="CbReaction" parent="."]
event = "grapple.fired"
subject = NodePath("$at")
place = 4
place_node = NodePath("$at/RightHand")
sound = "res://assets/sfx/prop_spawn.wav"
volume_db = -10.0
pitch_scale = 2.0
pitch_jitter = 0.1
max_distance = 30.0

[node name="Hit" type="CbReaction" parent="."]
event = "grapple.fired"
subject = NodePath("$at")
scene = "res://vfx/land.tscn"
scene_lifetime = 2.0
place = 1
