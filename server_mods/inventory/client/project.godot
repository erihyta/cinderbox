; The inventory mod's look: a workshop item players subscribe to. It contains no code; everything
; here is keyed on names the inventory server mod declares ("inventory.*").
; Publish it with: tools\publish_mod.ps1 -Mod inventory

config_version=5

[application]

config/name="Cinderbox item: inventory"
config/features=PackedStringArray("4.7", "Forward Plus")
