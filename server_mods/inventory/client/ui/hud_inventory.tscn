[gd_scene load_steps=4 format=3]

; The inventory's HUD: one box per slot along the bottom, laid over the game's when a server runs the
; inventory mod. Fields only, no scripts:
;   inventory.slot              the selected slot, from 1 (0: empty hands; press a slot's key again)
;   inventory.item_1 .. item_3  the NetId of each slot's item (0: empty); {look:...} is what it is called
; Each slot has two labels with the same text: Out is shown while the slot is out, Away otherwise.
; Restyle it freely, or override it from a player mod at res://ui/hud_inventory.tscn.

[sub_resource type="StyleBoxFlat" id="Box"]
bg_color = Color(0.08, 0.08, 0.1, 0.55)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="LabelSettings" id="Away"]
font_size = 17
font_color = Color(0.85, 0.87, 0.92, 0.75)
outline_size = 3
outline_color = Color(0, 0, 0, 0.8)

[sub_resource type="LabelSettings" id="Out"]
font_size = 17
font_color = Color(1, 0.85, 0.35, 1)
outline_size = 4
outline_color = Color(0, 0, 0, 0.85)

[node name="InventoryHud" type="CanvasLayer"]

[node name="Slots" type="HBoxContainer" parent="."]
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -290.0
offset_top = -108.0
offset_right = 290.0
offset_bottom = -72.0
grow_horizontal = 2
grow_vertical = 0
theme_override_constants/separation = 8
alignment = 1

[node name="Slot1" type="PanelContainer" parent="Slots"]
custom_minimum_size = Vector2(138, 36)
layout_mode = 2
theme_override_styles/panel = SubResource("Box")

[node name="Away" type="CbFieldLabel" parent="Slots/Slot1"]
layout_mode = 2
label_settings = SubResource("Away")
horizontal_alignment = 1
vertical_alignment = 1
text_format = "1   {look:inventory.item_1}"
conditions = PackedStringArray("inventory.slot != 1", "!combat.dead")

[node name="Out" type="CbFieldLabel" parent="Slots/Slot1"]
layout_mode = 2
label_settings = SubResource("Out")
horizontal_alignment = 1
vertical_alignment = 1
text_format = "1   {look:inventory.item_1}"
conditions = PackedStringArray("inventory.slot == 1", "!combat.dead")

[node name="Slot2" type="PanelContainer" parent="Slots"]
custom_minimum_size = Vector2(138, 36)
layout_mode = 2
theme_override_styles/panel = SubResource("Box")

[node name="Away" type="CbFieldLabel" parent="Slots/Slot2"]
layout_mode = 2
label_settings = SubResource("Away")
horizontal_alignment = 1
vertical_alignment = 1
text_format = "2   {look:inventory.item_2}"
conditions = PackedStringArray("inventory.slot != 2", "!combat.dead")

[node name="Out" type="CbFieldLabel" parent="Slots/Slot2"]
layout_mode = 2
label_settings = SubResource("Out")
horizontal_alignment = 1
vertical_alignment = 1
text_format = "2   {look:inventory.item_2}"
conditions = PackedStringArray("inventory.slot == 2", "!combat.dead")

[node name="Slot3" type="PanelContainer" parent="Slots"]
custom_minimum_size = Vector2(138, 36)
layout_mode = 2
theme_override_styles/panel = SubResource("Box")

[node name="Away" type="CbFieldLabel" parent="Slots/Slot3"]
layout_mode = 2
label_settings = SubResource("Away")
horizontal_alignment = 1
vertical_alignment = 1
text_format = "3   {look:inventory.item_3}"
conditions = PackedStringArray("inventory.slot != 3", "!combat.dead")

[node name="Out" type="CbFieldLabel" parent="Slots/Slot3"]
layout_mode = 2
label_settings = SubResource("Out")
horizontal_alignment = 1
vertical_alignment = 1
text_format = "3   {look:inventory.item_3}"
conditions = PackedStringArray("inventory.slot == 3", "!combat.dead")
