cbsheet 1

# The pistol: a gun (gun.cbsheet: its trigger, its rounds, its reload, which every simulation runs),
# with its own numbers, and how it looks. Plain paths are from the scene's root.
uses res://prefabs/gun.cbsheet

# Its numbers and its magazine (the used sheet's otherwise).
field gun.rounds int on item = 12
field gun.magazine int on item = 12
param gun.damage 25
param mark.range 80 m
param mark.seconds 1 s

# Flash, ShotSound
react on item.use
	as holder
		create muzzle_flash under Muzzle for 0.3
		at Muzzle
			sound gunshot volume -5 jitter 0.06 range 70

# Tracer: from the muzzle to where the server's shot ended.
react on item.reach
	as holder
		at beam from Muzzle
			create tracer for 0.06

# ScanBeam, MarkSound
react on item.use2
	as holder
		at beam from Muzzle
			create scan_beam for 0.15
		at Muzzle
			sound dry_click volume -4 pitch 1.8 range 25

# PredictScan: the mark mod's scan (its use2), still the server's with a guess here
predict use2 as item.use2 if !hand.gun.reloading and !combat.dead
	cooldown 0.95

# DrySound
react on item.use_failed
	as holder
		at Muzzle
			sound dry_click volume -8 range 12

# ReloadSound
react on item.reload
	as holder
		at Muzzle
			sound reload volume -10 range 25

# HitSurface
react on item.hit if event.value == 0
	as holder
		at point
			sound ricochet volume -16 jitter 0.3 range 30
			create bullet_spark for 1

# HitPlayer
react on item.hit if event.value > 0
	as holder
		at point
			sound body_hit volume -8 jitter 0.15 range 40
			create hit_puff for 1

# HitMarker
react on item.hit if local and event.value > 0
	as holder
		at holder/Head
			sound hit_marker volume -6
