cbsheet 1

# The pistol: a gun (gun.cbsheet: its trigger, its rounds, its reload, which every simulation runs),
# with its own numbers, and how it looks. Plain paths are from the scene's root.
uses res://prefabs/gun.cbsheet

# Its numbers, its magazine's among them (the used sheet's otherwise).
param gun.capacity 12
param gun.damage 25
param mark.range 80 m
param mark.seconds 1 s

# Flash, ShotSound
react on item.use
	as holder
		at Muzzle attached
			create muzzle_flash for 0.3 s
		at Muzzle
			sound gunshot volume -5 jitter 0.06 range 70 m

# Tracer: from the muzzle to where the server's shot ended.
react on item.reach
	as holder
		at beam from Muzzle
			create tracer for 0.06 s

# ScanBeam, MarkSound
react on item.use2
	as holder
		at beam from Muzzle
			create scan_beam for 0.15 s
		at Muzzle
			sound dry_click volume -4 pitch 1.8 range 25 m

# PredictScan: the mark mod's scan (its use2), still the server's with a guess here, as often as
# the mark mod allows one
predict use2 as item.use2 if !hand.gun.reloading and !combat.dead
	cooldown mark.seconds

# DrySound
react on item.use_failed
	as holder
		at Muzzle
			sound dry_click volume -8 range 12 m

# ReloadSound
react on item.reload
	as holder
		at Muzzle
			sound reload volume -10 range 25 m

# HitSurface
react on item.hit if event.value == 0
	as holder
		at point
			sound ricochet volume -16 jitter 0.3 range 30 m
			create bullet_spark for 1 s

# HitPlayer
react on item.hit if event.value > 0
	as holder
		at point
			sound body_hit volume -8 jitter 0.15 range 40 m
			create hit_puff for 1 s

# HitMarker
react on item.hit if local and event.value > 0
	as holder
		at holder/Head
			sound hit_marker volume -6
