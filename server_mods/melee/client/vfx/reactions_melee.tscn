[gd_scene format=3]

; How the melee mod sounds, as world reactions; the bat's own glow and sparks are reactions in
; prefabs/bat.tscn. The Bat node says how the "melee.bat" item looks. PredictSwing says what the
; server answers to the viewer's own "fire" press with the bat out, so the swing is heard at once,
; and which stance the server will set, so the body swings at once too.

[node name="MeleeReactions" type="Node3D"]

[node name="PredictSwing" type="CbPrediction" parent="."]
action = "fire"
cue = "melee.swing"
conditions = PackedStringArray("melee.bat")
cooldown = 0.58
stance = "melee_swing"
stance_layer = "full"

[node name="Swing" type="CbReaction" parent="."]
event = "melee.swing"
subject = NodePath("$at")
place = 4
place_node = NodePath("$at/RightHand")
sound = "res://assets/sfx/swing.wav"
volume_db = -6.0
pitch_jitter = 0.08
max_distance = 30.0

[node name="HitPlayer" type="CbReaction" parent="."]
event = "melee.hit"
subject = NodePath("$at")
conditions = PackedStringArray("event.value > 0")
place = 1
sound = "res://assets/sfx/bat_hit.wav"
volume_db = -2.0
pitch_jitter = 0.1
max_distance = 40.0

[node name="HitProp" type="CbReaction" parent="."]
event = "melee.hit"
subject = NodePath("$at")
conditions = PackedStringArray("event.value == 0")
place = 1
sound = "res://assets/sfx/bat_hit.wav"
volume_db = -10.0
pitch_jitter = 0.2
max_distance = 25.0
