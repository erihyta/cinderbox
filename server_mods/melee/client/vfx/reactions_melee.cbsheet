cbsheet 1

# reactions_melee.tscn's reactions, as a rules sheet (CbRules: docs/looks.md, Rules sheets). Plain paths are
# from the scene's root.

# Swing
react on melee.swing
	as actor
		at actor/RightHand
			sound melee_swing volume -6 jitter 0.08 range 30 m

# Hit: whatever the swing found (the sheet's melee.hit, predicted: heard at once). The same on a
# player and on a prop: a find's event carries no damage to be louder by.
react on melee.hit
	as actor
		at point
			sound melee_bat_hit volume -4 jitter 0.12 range 40 m
