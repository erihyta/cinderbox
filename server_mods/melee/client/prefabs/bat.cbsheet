cbsheet 1

# The bat (step 5, M282: every item a sheet): what it does to bodies (predicted: every simulation
# runs it) and how it looks. The damage and the heat are the melee mod's (melee.cpp), on melee.hit.

# Its names (the melee mod's C++ finds them) and its numbers.
field melee.hot bool shared
event melee.swing
event melee.strike
event melee.done
event melee.hit
param inventory.start 1
param item.ruled 1
param pickup.hold_seconds 0.5 s

# A swing, on the left mouse button: the pack plays it (melee.swing), and at the clip's melee.strike
# marker a box where the player looks, pitch and all: 1.9 m ahead, 1.4 m across, 1.4 m from low to
# high, turned about the chest with the look. In it, the nearest player (hurt by the server, nudged
# here) and the two nearest loose bodies (knocked away): a player is never missed for a ball lying
# nearer. Without the marker (a body the pack does not fit) the timeout hits the same way. The next
# swing waits for melee.done, the follow-through's end: how long a swing lasts is the clip's alone
# (1.1 s, animation_packs/source/Sword_Attack.res).
motion Swing on use
	cooldown 0.3
	emit melee.swing
	wait for melee.strike within 0.6
	find box (1.4, 1.4, 1.9) at (0, 1, 1.05) turned look players max 1
		emit melee.hit
		impulse 2 along facing
	find box (1.4, 1.4, 1.9) at (0, 1, 1.05) turned look bodies max 2
		emit melee.hit
		impulse 7 along facing
	timeout
	find box (1.4, 1.4, 1.9) at (0, 1, 1.05) turned look players max 1
		emit melee.hit
		impulse 2 along facing
	find box (1.4, 1.4, 1.9) at (0, 1, 1.05) turned look bodies max 2
		emit melee.hit
		impulse 7 along facing
	wait for melee.done within 1.3

# GlowWhileHot: melee.hot is the bat's own field, set by the server for 2 s after it hurts someone.
react while melee.hot
	set Model/Barrel surface_material_override/0:emission_energy_multiplier 4.0

# FlamesOnSwing
# SparksOnSwing: The sparks of a swing, started again at every swing. (A one-shot particle node that an animation only switches on does not start again while its last burst is still out: swings in a row had no sparks.)
react on melee.swing
	as holder
		play AnimationPlayer slash
		after 0.14
			call Model/Sparks restart

# SparksOnHit
react on melee.hit
	as holder
		call Model/Sparks restart
