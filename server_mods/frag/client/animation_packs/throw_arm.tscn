[gd_scene format=3]

[ext_resource type="PackedScene" path="res://placeholder/skeleton.tscn" id="1_skeleton"]
[ext_resource type="Animation" path="res://placeholder/clips/Idle.res" id="2_idle"]
[ext_resource type="Animation" path="res://animation_packs/source/Throw.res" id="3_throw"]

[sub_resource type="AnimationLibrary" id="Clips"]
_data = {
&"Idle": ExtResource("2_idle"),
&"Throw": ExtResource("3_throw")
}

[sub_resource type="AnimationNodeAnimation" id="IdleClip"]
animation = &"Idle"

[sub_resource type="AnimationNodeAnimation" id="ThrowClip"]
animation = &"Throw"

[sub_resource type="AnimationNodeStateMachineTransition" id="StartToIdle"]
advance_mode = 2

[sub_resource type="AnimationNodeStateMachineTransition" id="StartToReady"]
advance_mode = 2

[sub_resource type="AnimationNodeStateMachineTransition" id="ReadyToThrow"]
advance_mode = 2
advance_expression = "motion.frag.grenade.Throwing"

[sub_resource type="AnimationNodeStateMachineTransition" id="ThrowToReady"]
advance_mode = 2
advance_expression = "state_time > 0.9"

[sub_resource type="AnimationNodeStateMachine" id="FullBody"]
states/Idle/node = SubResource("IdleClip")
states/Idle/position = Vector2(300, 100)
transitions = ["Start", "Idle", SubResource("StartToIdle")]

[sub_resource type="AnimationNodeStateMachine" id="Throw"]
states/Ready/node = SubResource("IdleClip")
states/Ready/position = Vector2(300, 100)
states/Throw/node = SubResource("ThrowClip")
states/Throw/position = Vector2(550, 100)
transitions = ["Start", "Ready", SubResource("StartToReady"), "Ready", "Throw", SubResource("ReadyToThrow"), "Throw", "Ready", SubResource("ThrowToReady")]

[sub_resource type="AnimationNodeBlend2" id="ThrowBlend"]
filter_enabled = true
filters = ["%Skeleton3D:LeftShoulder", "%Skeleton3D:LeftUpperArm", "%Skeleton3D:LeftLowerArm", "%Skeleton3D:LeftHand", "%Skeleton3D:LeftIndexProximal", "%Skeleton3D:LeftIndexIntermediate", "%Skeleton3D:LeftIndexDistal", "%Skeleton3D:LeftMiddleProximal", "%Skeleton3D:LeftMiddleIntermediate", "%Skeleton3D:LeftMiddleDistal", "%Skeleton3D:LeftLittleProximal", "%Skeleton3D:LeftLittleIntermediate", "%Skeleton3D:LeftLittleDistal", "%Skeleton3D:LeftRingProximal", "%Skeleton3D:LeftRingIntermediate", "%Skeleton3D:LeftRingDistal", "%Skeleton3D:LeftThumbMetacarpal", "%Skeleton3D:LeftThumbProximal", "%Skeleton3D:LeftThumbDistal"]

[sub_resource type="AnimationNodeBlendTree" id="Tree"]
nodes/output/position = Vector2(700, 160)
nodes/FullBody/node = SubResource("FullBody")
nodes/FullBody/position = Vector2(100, 60)
nodes/Throw/node = SubResource("Throw")
nodes/Throw/position = Vector2(100, 260)
nodes/ThrowBlend/node = SubResource("ThrowBlend")
nodes/ThrowBlend/position = Vector2(420, 160)
node_connections = [&"ThrowBlend", 0, &"FullBody", &"ThrowBlend", 1, &"Throw", &"output", 0, &"ThrowBlend"]

[node name="ThrowArmPack" type="CbAnimPack"]
character_name = "frag.throw_arm"
skeleton_path = NodePath("Skeleton3D")
animation_player_path = NodePath("AnimationPlayer")
animation_tree_path = NodePath("AnimationTree")
replaces = PackedStringArray("Throw")
graph_inputs = {
"ThrowBlend/blend_amount": "motion.frag.grenade.Throwing"
}
editor_description = "The frag grenade's throw: its animation pack (the grenade's Animation Pack, prefabs/frag.tscn).

Throw is a layer no character has, so it is laid over the body, and its ThrowBlend's bone filter keeps it to the left arm: whatever the right hand holds stays held. Its weight, \"motion.frag.grenade.Throwing\", is 1 for the 0.7 s the grenade's Throwing motion is on (from the press of its key), then eases out. Ready goes to Throw when that starts, so the clip plays from its start each time.

The clip carries a marker, frag.release: where the hand lets go. Every simulation plays the clip, so the marker says frag.release on the same tick everywhere, and the grenade's Release motion throws the grenade the player carries then. Move the marker to change the moment; put a real throw in Throw and keep its marker.

FullBody is here only to see the pose over a standing body in the editor: Replaces names Throw alone, so it is not baked.

The clip (animation_packs/source/Throw.res) is the SDK placeholder's Sprint (CC0), not looped, with the marker added at 0.27 s of its 0.67 s. Saving this scene bakes anim/frag.throw_arm/."

[node name="Skeleton3D" parent="." instance=ExtResource("1_skeleton")]
unique_name_in_owner = true

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
root_node = NodePath("..")
libraries/ = SubResource("Clips")

[node name="AnimationTree" type="AnimationTree" parent="."]
active = false
root_node = NodePath("..")
tree_root = SubResource("Tree")
anim_player = NodePath("../AnimationPlayer")
parameters/ThrowBlend/blend_amount = 1.0
