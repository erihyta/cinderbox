[gd_scene format=3]

; The frag grenade: thrown from the hand, it bounces and rolls, and goes off when its fuse is out,
; 2.5 s after it left the hand (the launch's seconds: when its time is up, every simulation sets it
; off where it is, as its sheet says: frag.rules; the frag mod hurts who is near). An item (CbItem), so it has
; a body in the world that every simulation agrees on: a sphere 18 cm across, 0.4 kg, bouncier than
; the impact grenade, which went off on the first hard hit.
;
; It goes to slot 6 if that is free, out of sight, three to a stack (stack). Its own key (H, use_key)
; throws one from wherever it is carried, or select it and press the use button (use: a press):
; what is thrown is one off the stack. The mod gives them one at a time, a little
; apart, until there are three (frag.cpp).
;   Throwing   CbMotion   on the press (frag.grenade.used), 0.7 s: the left arm's throw, its pack's
;                         (animation_packs/throw_arm.tscn); its clip says frag.release at 0.27 s
;   Release    CbMotion   on frag.release (the clip's marker): emits frag.thrown
;     Frag     CbLaunch   the one carried, where the camera looks at 15 m/s, 3 m/s of lift and the
;                         thrower's own velocity, from 0.8 m ahead; its time is up after 2.5 s
;   Blast      Area3D     the region its blast throws things in: a ball 8 m round (how far it reaches
;                         is the frag mod's frag.radius, within it; not the grenade's body)
;   Rules      CbRules    frag.rules: the blast (owner item: the grenade's, on expired)
;
; Saving this scene bakes it into res://items/frag.grenade.cfg.

[sub_resource type="SphereShape3D" id="Body"]
radius = 0.09

[sub_resource type="SphereShape3D" id="Reach"]
radius = 8.0

[sub_resource type="StandardMaterial3D" id="Shell"]
albedo_color = Color(0.22, 0.24, 0.2, 1)
metallic = 0.3
roughness = 0.5

[sub_resource type="SphereMesh" id="Ball"]
material = SubResource("Shell")
radius = 0.09
height = 0.18
radial_segments = 16
rings = 8

[sub_resource type="StandardMaterial3D" id="Band"]
albedo_color = Color(1, 0.8, 0.15, 1)
emission_enabled = true
emission = Color(1, 0.75, 0.1, 1)
emission_energy_multiplier = 1.5

[sub_resource type="CylinderMesh" id="BandMesh"]
material = SubResource("Band")
top_radius = 0.092
bottom_radius = 0.092
height = 0.025
radial_segments = 16

[node name="Frag" type="CbItem"]
kind = "frag.grenade"
display_name = "Grenade"
properties = {
"inventory.start": 1.0
}
animation_pack = "frag.throw_arm"
use = 1
slot = 6
use_key = "H"
stack = 3
mass = 0.4
friction = 0.8
bounce = 0.45

[node name="Body" type="CollisionShape3D" parent="."]
shape = SubResource("Body")

[node name="Ball" type="MeshInstance3D" parent="."]
mesh = SubResource("Ball")

[node name="Band" type="MeshInstance3D" parent="."]
mesh = SubResource("BandMesh")

[node name="Throwing" type="CbMotion" parent="."]
when = 2
event = "frag.grenade.used"
with_item = 1
cooldown = 0.7
duration = 0.7

[node name="Release" type="CbMotion" parent="."]
when = 2
event = "frag.release"
with_item = 1
emits = "frag.thrown"

[node name="Frag" type="CbLaunch" parent="Release"]
what = 1
speed = 15.0
lift = 3.0
ahead = 0.8
seconds = 2.5

[node name="Blast" type="Area3D" parent="."]

[node name="Shape" type="CollisionShape3D" parent="Blast"]
shape = SubResource("Reach")

[node name="Rules" type="CbRules" parent="."]
file = "res://prefabs/frag.rules"
