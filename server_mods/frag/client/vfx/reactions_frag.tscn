[gd_scene format=3]

; How a frag grenade looks and sounds. The grenade itself needs nothing here: it is an item, drawn
; from its own scene (prefabs/frag.tscn) wherever the simulation has it.
;
;   Thrown  on frag.thrown, at the thrower: the throw's sound
;   Blast   on frag.blast, at the point it went off: the burst, the bang, and a shake of the
;           screen
; The reactions: the rules sheet beside this scene (reactions_frag.rules).

[node name="FragReactions" type="Node3D"]

[node name="Rules" type="CbRules" parent="."]
file = "res://vfx/reactions_frag.rules"
