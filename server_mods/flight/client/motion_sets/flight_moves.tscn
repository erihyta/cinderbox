[gd_scene format=3]

; The flight mod's motions. Every simulation runs them from the player's own input, so all of it
; is predicted: the toggle, the flying, the thrust, and the fuel the gauge shows.
;
;   Rules   CbRules   flight_moves.rules: FlyOn and FlyOff on "fly" (T), Flying while flight.on,
;                     the jetpack's Thrust and Refuel (where flight.jetpack_on), and the Glide
;
; Saving this scene bakes it into res://motions/flight.moves.cfg.

[node name="Moves" type="CbMotionSet"]
set_name = "flight.moves"

[node name="Rules" type="CbRules" parent="."]
file = "res://motion_sets/flight_moves.rules"
