cbsheet 1

# reactions_flight.tscn's reactions, as a rules sheet (CbRules: docs/looks.md, Rules sheets). Plain paths are
# from the scene's root.

# Started
react on flight.started
	as actor
		at point
			sound prop_spawn volume -12 pitch 0.7 range 30
			create jump for 2

# Stopped
react on flight.stopped
	as actor
		at point
			sound prop_destroy volume -14 pitch 0.8 range 30

# Thrust
react on flight.thrust
	cooldown 0.2
	as actor
		at point
			sound jump volume -12 pitch 0.6 range 30
			create land for 2
