cbsheet 1

# The fist: a jab, twice in a row; the third use within the combo's window is a finisher. A press
# starts the punch (the pack, brawl.fists, plays it); the hit is where the fist lands: the clip's
# brawl.fist.strike marker. Whoever is in the box in front of the body then (2.6 m ahead, knee to head
# height; M279: turned with the look, pitch and all, about the chest: with the fist out the body faces
# the camera and its upper body bends with the pitch, so a punch reaches up and down where it is
# drawn) is hit (said with who it was: the brawl mod's damage) and pushed. The punch is over
# at the clip's brawl.fist.ready marker (the fist mostly back): until then the next one cannot start,
# so spamming plays whole punches.
# Without the markers (a body the pack does not fit, a server without the pack) the punch lands a
# moment later anyway: the "within" gives up and its timeout hits the same way.

# Its names (the brawl mod's C++ finds them) and its numbers.
field brawl.combo int
field brawl.combo_left timer
event brawl.fist.strike
event brawl.fist.ready
event brawl.jab.hit
event brawl.finisher.hit
param inventory.start 1

# The box a punch hits in, written once (M289: a word for some words).
let hitbox = box (0.8, 1.2, 2.6) at (0, 1, 1.4) turned look max 1

motion Jab on use if not linked and brawl.combo < 2
	tags attack, punch
	blocked by punch, guard, pulled
	cooldown 0.3
	change brawl.combo += 1
	change brawl.combo_left = 1.5
	wait for brawl.fist.strike within 0.35
	find hitbox
		emit brawl.jab.hit
		impulse 4 along facing
	timeout
	find hitbox
		emit brawl.jab.hit
		impulse 4 along facing
	wait for brawl.fist.ready within 0.7

motion Finisher on use if brawl.combo >= 2
	tags attack, punch
	blocked by punch, guard, pulled
	cooldown 0.3
	change brawl.combo = 0
	wait for brawl.fist.strike within 0.5
	find hitbox
		emit brawl.finisher.hit
		impulse 70 along facing
		impulse 5 along up
	timeout
	find hitbox
		emit brawl.finisher.hit
		impulse 70 along facing
		impulse 5 along up
	wait for brawl.fist.ready within 0.9

# The combo's window: brawl.combo_left counts down by itself (a timer); when it is out, the combo is
# over (while the fists are carried at all).
motion ComboOver while brawl.combo_left <= 0 and brawl.combo > 0
	for carrier
	change brawl.combo = 0
