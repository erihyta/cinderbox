[gd_scene format=3]

; Ground slam: its slot's key (4), in the air. You dive straight down; where you land, everyone within 5 m is hurt
; and thrown away from you. 5 s to come back (brawl.cd_slam). The dive is predicted; the landing's
; shockwave is the server mod's (brawl.cpp: no node finds who is near a point, and no motion starts
; on landing), so its victims see it a round trip late.
;   Slam        CbItem     once a press, by its slot's key; what a use does is its sheet's
;                          (slam.rules): a dive, 25 m/s straight down, and brawl.slam.started

[sub_resource type="BoxShape3D" id="Body"]
size = Vector3(0.1, 0.1, 0.1)

[sub_resource type="StandardMaterial3D" id="Mat"]
albedo_color = Color(0.8, 0.25, 0.25, 1)
emission_enabled = true
emission = Color(0.8, 0.25, 0.25, 1)
emission_energy_multiplier = 0.6

[sub_resource type="BoxMesh" id="Mesh"]
material = SubResource("Mat")
size = Vector3(0.1, 0.1, 0.1)

[node name="Slam" type="CbItem"]
kind = "brawl.slam"
display_name = "Ground slam"
properties = {
"inventory.start": 1.0
}
use = 1
slot = 4
slot_key_uses = true
mass = 0.5
hud = "res://ui/slam_hud.tscn"
hud_shows = 1

[node name="Body" type="CollisionShape3D" parent="."]
shape = SubResource("Body")

[node name="Mesh" type="MeshInstance3D" parent="."]
mesh = SubResource("Mesh")

[node name="Rules" type="CbRules" parent="."]
file = "res://prefabs/slam.rules"
