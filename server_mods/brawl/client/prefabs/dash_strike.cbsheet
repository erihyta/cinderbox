cbsheet 1

# The dash strike: a lunge, 16 m/s, a moment without friction, 3 s apart; whoever is ahead (4 m) is
# knocked back.

# Its names (the brawl mod's C++ finds them).
event brawl.dash_strike.started
event brawl.dash_strike.hit
param inventory.start 1
# How it meets the other skills: its tag, and what it waits out (the guard's tag, the telekinesis's status).
tag attack
tag guard
status pulled

motion Strike on use
	tags attack
	blocked by guard, pulled
	cooldown 3 s
	emit brawl.dash_strike.started
	impulse 16 m/s replace horizontal
	move for 0.25 s friction 0

# Whoever is ahead when the lunge starts. (A cast has a motion of its own: a motion with one happens
# only when it finds something, and the lunge goes either way. For its carrier: the skill is used
# by its slot's key, not out in the hand.)
motion Hit on brawl.dash_strike.started
	for carrier
	lasts 0.05 s
	cast ray range 4 m along facing
		emit brawl.dash_strike.hit
		impulse 10 m/s along facing
