# The ground slam: a dive straight down, in the air, 5 s apart; and where it lands, said on the tick
# after it touches the ground, by every simulation (the brawl mod's shockwave answers it).

motion Slam on use if brawl.cd_slam <= 0 and not grounded
	lasts 3
	change brawl.cd_slam = 5
	emit brawl.slam.started
	impulse 25 along world direction (0, -1, 0) replace vertical
	then when grounded
	emit brawl.slam.landed
