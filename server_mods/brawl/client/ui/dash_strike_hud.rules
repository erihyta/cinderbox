# The dash strike's line: READY in green, or the seconds left.
text Line "[{key:slot2}]  DASH STRIKE  READY" if brawl.cd_dash <= 0
text Line "[{key:slot2}]  DASH STRIKE  {brawl.cd_dash}s" if brawl.cd_dash > 0
bind Line modulate:r = 1 - 0.45 * (brawl.cd_dash <= 0)
bind Line modulate:b = 1 - 0.45 * (brawl.cd_dash <= 0)
