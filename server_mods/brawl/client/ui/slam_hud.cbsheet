cbsheet 1

# The ground slam's line: READY in green, or the seconds left.
hud Line
	text "[{key:slot4}]  GROUND SLAM  READY" if brawl.cd_slam <= 0
	text "[{key:slot4}]  GROUND SLAM  {brawl.cd_slam}s" if brawl.cd_slam > 0
	bind modulate:r = 1 - 0.45 * (brawl.cd_slam <= 0)
	bind modulate:b = 1 - 0.45 * (brawl.cd_slam <= 0)
