[gd_scene format=3]

; The kit's HUD: the combo, where it is and how it looks; what it says is the rules sheet beside this
; scene (hud_brawl.rules). Each skill's line is its own HUD (CbItem.hud), shown while it is carried.

[sub_resource type="LabelSettings" id="Combo"]
font_size = 30
font_color = Color(1, 0.8, 0.3, 1)
outline_size = 6
outline_color = Color(0, 0, 0, 0.8)

[node name="BrawlHud" type="CanvasLayer"]

[node name="Combo" type="Label" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -150.0
offset_top = 120.0
offset_right = 150.0
offset_bottom = 160.0
horizontal_alignment = 1
label_settings = SubResource("Combo")

[node name="Rules" type="CbRules" parent="."]
file = "res://ui/hud_brawl.rules"
