[gd_scene format=3]

; The kit's HUD: the labels, where they are and how they look. What they say and when they show is
; the rules sheet beside this scene (hud_brawl.rules).

[sub_resource type="LabelSettings" id="Small"]
font_size = 20
outline_size = 4
outline_color = Color(0, 0, 0, 0.75)

[sub_resource type="LabelSettings" id="Combo"]
font_size = 30
font_color = Color(1, 0.8, 0.3, 1)
outline_size = 6
outline_color = Color(0, 0, 0, 0.8)

[node name="BrawlHud" type="CanvasLayer"]

[node name="Skills" type="VBoxContainer" parent="."]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = -260.0
offset_right = 360.0
offset_bottom = -120.0
theme_override_constants/separation = 4

[node name="Dash" type="Label" parent="Skills"]
layout_mode = 2
label_settings = SubResource("Small")

[node name="Upper" type="Label" parent="Skills"]
layout_mode = 2
label_settings = SubResource("Small")

[node name="Slam" type="Label" parent="Skills"]
layout_mode = 2
label_settings = SubResource("Small")

[node name="Guard" type="Label" parent="Skills"]
layout_mode = 2
label_settings = SubResource("Small")

[node name="Combo" type="Label" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -150.0
offset_top = 120.0
offset_right = 150.0
offset_bottom = 160.0
horizontal_alignment = 1
label_settings = SubResource("Combo")

[node name="Rules" type="CbRules" parent="."]
file = "res://ui/hud_brawl.rules"
