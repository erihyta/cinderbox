[gd_scene format=3]

[ext_resource type="PackedScene" path="res://placeholder/skeleton.tscn" id="1_skeleton"]
[ext_resource type="Animation" path="res://animation_packs/source/Punch_Jab.res" id="2_jab"]
[ext_resource type="Animation" path="res://animation_packs/source/Punch_Cross.res" id="3_cross"]
[ext_resource type="Animation" path="res://placeholder/clips/Idle.res" id="4_idle"]

[sub_resource type="AnimationLibrary" id="Clips"]
_data = {
&"Idle": ExtResource("4_idle"),
&"Punch_Cross": ExtResource("3_cross"),
&"Punch_Jab": ExtResource("2_jab")
}

[sub_resource type="AnimationNodeAnimation" id="ReadyClip"]
animation = &"Idle"

[sub_resource type="AnimationNodeAnimation" id="JabClip"]
animation = &"Punch_Jab"

[sub_resource type="AnimationNodeAnimation" id="CrossClip"]
animation = &"Punch_Cross"

[sub_resource type="AnimationNodeAnimation" id="FinisherClip"]
animation = &"Punch_Cross"

[sub_resource type="AnimationNodeTimeScale" id="FinisherScale"]

[sub_resource type="AnimationNodeBlendTree" id="Finisher"]
nodes/Clip/node = SubResource("FinisherClip")
nodes/Clip/position = Vector2(-200, 100)
nodes/Scale/node = SubResource("FinisherScale")
nodes/Scale/position = Vector2(0, 100)
nodes/output/position = Vector2(200, 100)
node_connections = [&"Scale", 0, &"Clip", &"output", 0, &"Scale"]

[sub_resource type="Curve" id="Snap"]
_data = [Vector2(0, 0), 0.0, 0.0, 0, 0, Vector2(1, 1), 2.5, 0.0, 0, 0]
point_count = 2

[sub_resource type="AnimationNodeStateMachineTransition" id="GuardStart"]
advance_mode = 2

[sub_resource type="AnimationNodeStateMachineTransition" id="ReadyToJab"]
xfade_time = 0.05
advance_mode = 2
advance_expression = "motion.brawl.fist.Jab and brawl.combo == 1"

[sub_resource type="AnimationNodeStateMachineTransition" id="CrossToJab"]
xfade_time = 0.05
advance_mode = 2
advance_expression = "motion.brawl.fist.Jab and brawl.combo == 1"

[sub_resource type="AnimationNodeStateMachineTransition" id="ReadyToCross"]
xfade_time = 0.05
advance_mode = 2
advance_expression = "motion.brawl.fist.Jab and brawl.combo == 2"

[sub_resource type="AnimationNodeStateMachineTransition" id="JabToCross"]
xfade_time = 0.05
advance_mode = 2
advance_expression = "motion.brawl.fist.Jab and brawl.combo == 2"

[sub_resource type="AnimationNodeStateMachineTransition" id="JabToReady"]
xfade_time = 0.2
switch_mode = 2
advance_mode = 2

[sub_resource type="AnimationNodeStateMachineTransition" id="CrossToReady"]
xfade_time = 0.2
switch_mode = 2
advance_mode = 2

[sub_resource type="AnimationNodeStateMachine" id="Guard"]
states/Ready/node = SubResource("ReadyClip")
states/Ready/position = Vector2(300, 100)
states/Jab/node = SubResource("JabClip")
states/Jab/position = Vector2(550, 0)
states/Cross/node = SubResource("CrossClip")
states/Cross/position = Vector2(550, 200)
transitions = ["Start", "Ready", SubResource("GuardStart"), "Ready", "Jab", SubResource("ReadyToJab"), "Cross", "Jab", SubResource("CrossToJab"), "Ready", "Cross", SubResource("ReadyToCross"), "Jab", "Cross", SubResource("JabToCross"), "Jab", "Ready", SubResource("JabToReady"), "Cross", "Ready", SubResource("CrossToReady")]

[sub_resource type="AnimationNodeStateMachineTransition" id="StartToGuard"]
advance_mode = 2

[sub_resource type="AnimationNodeStateMachineTransition" id="GuardToFinisher"]
xfade_time = 0.08
xfade_curve = SubResource("Snap")
advance_mode = 2
advance_expression = "motion.brawl.fist.Finisher"

[sub_resource type="AnimationNodeStateMachineTransition" id="FinisherToGuard"]
xfade_time = 0.25
switch_mode = 2
advance_mode = 2

[sub_resource type="AnimationNodeStateMachine" id="UpperBody"]
states/Guard/node = SubResource("Guard")
states/Guard/position = Vector2(300, 100)
states/Finisher/node = SubResource("Finisher")
states/Finisher/position = Vector2(600, 100)
transitions = ["Start", "Guard", SubResource("StartToGuard"), "Guard", "Finisher", SubResource("GuardToFinisher"), "Finisher", "Guard", SubResource("FinisherToGuard")]

[sub_resource type="AnimationNodeBlendTree" id="Tree"]
nodes/output/position = Vector2(608, 160)
nodes/UpperBody/node = SubResource("UpperBody")
nodes/UpperBody/position = Vector2(200, 100)
node_connections = [&"output", 0, &"UpperBody"]

[node name="FistsPack" type="CbAnimPack"]
character_name = "brawl.fists"
skeleton_path = NodePath("Skeleton3D")
animation_player_path = NodePath("AnimationPlayer")
animation_tree_path = NodePath("AnimationTree")
editor_description = "How the fist punches: an animation pack for the upper body, played instead of the holder's own while the fist is out (prefabs/fist.tscn: animation_pack).
Ready is the idle. The fist's sheet (prefabs/fist.rules) counts the combo: its Jab motion raises brawl.combo to 1, then 2; its Finisher sets it back to 0. So: the first jab plays Punch_Jab, the second Punch_Cross, the finisher Punch_Cross again at three quarters of its speed (the Finisher state's TimeScale), eased in by its crossfade's curve. The jabs are a nested state machine, Guard (Ready, Jab, Cross): the finisher leaves it from any of them, and comes back to its start (Ready) at its end (its ready marker comes a tick before, so a new jab starts from Ready).
The motions are the sheet's, run by every simulation: the punches are predicted with the hit, so they play at the click.
The clips are the mannequin's (CC0), taken by godot/addons/cinderbox_maps/make_weapon_clips.gd -- --mod=brawl. Skeleton3D is the SDK's placeholder: leave it. Saving this scene bakes it into res://anim/brawl.fists/."

[node name="Skeleton3D" parent="." instance=ExtResource("1_skeleton")]
unique_name_in_owner = true

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
root_node = NodePath("..")
libraries/ = SubResource("Clips")

[node name="AnimationTree" type="AnimationTree" parent="."]
active = false
root_node = NodePath("..")
tree_root = SubResource("Tree")
anim_player = NodePath("../AnimationPlayer")
parameters/UpperBody/Finisher/Scale/scale = 0.75
