[gd_scene format=3]

; How the kit sounds, as world reactions. One CbReaction is one event: four kinds of hit are four
; nodes that differ only in their event and volume, and each skill's whoosh is one more.
;   JabHit, FinisherHit, DashHit, UpperHit   CbReaction   a thud where the hit landed
;   DashWhoosh, UpperWhoosh, SlamDive        CbReaction   a whoosh at the player
;   SlamLand                                 CbReaction   a heavy thud where the slam landed

[node name="BrawlReactions" type="Node3D"]

[node name="JabHit" type="CbReaction" parent="."]
event = "brawl.jab.hit"
subject = NodePath("$at")
place = 1
sound = "res://assets/sfx/bat_hit.wav"
volume_db = -6.0
pitch_jitter = 0.1
max_distance = 40.0

[node name="FinisherHit" type="CbReaction" parent="."]
event = "brawl.finisher.hit"
subject = NodePath("$at")
place = 1
sound = "res://assets/sfx/bat_hit.wav"
volume_db = 0.0
pitch_jitter = 0.1
max_distance = 40.0

[node name="DashHit" type="CbReaction" parent="."]
event = "brawl.dash_strike.hit"
subject = NodePath("$at")
place = 1
sound = "res://assets/sfx/bat_hit.wav"
volume_db = -2.0
pitch_jitter = 0.1
max_distance = 40.0

[node name="UpperHit" type="CbReaction" parent="."]
event = "brawl.uppercut.hit"
subject = NodePath("$at")
place = 1
sound = "res://assets/sfx/bat_hit.wav"
volume_db = -2.0
pitch_jitter = 0.1
max_distance = 40.0

[node name="DashWhoosh" type="CbReaction" parent="."]
event = "brawl.dash_strike.started"
subject = NodePath("$at")
place = 4
place_node = NodePath("$at/RightHand")
sound = "res://assets/sfx/swing.wav"
volume_db = -6.0
pitch_jitter = 0.08
max_distance = 30.0

[node name="UpperWhoosh" type="CbReaction" parent="."]
