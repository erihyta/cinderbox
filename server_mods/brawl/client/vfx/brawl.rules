# How the brawler's kit sounds, for everyone: a thud where each hit lands, a whoosh on each skill,
# a heavy thud where a slam lands. $at is who the event is about.

on brawl.jab.hit
    subject $at
    at point
    sound res://assets/sfx/bat_hit.wav volume -6 jitter 0.1 range 40

on brawl.finisher.hit
    subject $at
    at point
    sound res://assets/sfx/bat_hit.wav jitter 0.1 range 40

on brawl.dash_strike.hit
    subject $at
    at point
    sound res://assets/sfx/bat_hit.wav volume -2 jitter 0.1 range 40

on brawl.uppercut.hit
    subject $at
    at point
    sound res://assets/sfx/bat_hit.wav volume -2 jitter 0.1 range 40

on brawl.dash_strike.started
    subject $at
    at $at/RightHand
    sound res://assets/sfx/swing.wav volume -6 jitter 0.08 range 30

on brawl.uppercut.started
    subject $at
    at $at/RightHand
    sound res://assets/sfx/swing.wav volume -6 jitter 0.08 range 30

on brawl.slam.started
    subject $at
    at $at/RightHand
    sound res://assets/sfx/swing.wav volume -6 jitter 0.08 range 30

on brawl.slam.landed
    subject $at
    at point
    sound res://assets/sfx/bat_hit.wav volume 4 pitch 0.5 range 60
