cbsheet 1

# How the brawler's kit sounds, for everyone: a thud where each hit lands, a whoosh on each skill,
# a heavy thud where a slam lands. $at is who the event is about.

react on brawl.jab.hit
	as actor
		at point
			sound brawl_hit volume -6 jitter 0.1 range 40 m

react on brawl.finisher.hit
	as actor
		at point
			sound brawl_hit jitter 0.1 range 40 m

react on brawl.dash_strike.hit
	as actor
		at point
			sound brawl_hit volume -2 jitter 0.1 range 40 m

react on brawl.uppercut.hit
	as actor
		at point
			sound brawl_hit volume -2 jitter 0.1 range 40 m

react on brawl.dash_strike.started
	as actor
		at actor/RightHand
			sound brawl_swing volume -6 jitter 0.08 range 30 m

react on brawl.uppercut.started
	as actor
		at actor/RightHand
			sound brawl_swing volume -6 jitter 0.08 range 30 m

react on brawl.slam.started
	as actor
		at actor/RightHand
			sound brawl_swing volume -6 jitter 0.08 range 30 m

react on brawl.slam.landed
	as actor
		at point
			sound brawl_hit volume 4 pitch 0.5 range 60 m

react on brawl.tk.pulled
	as actor
		at point
			sound brawl_swing volume -2 pitch 0.6 range 40 m

react on brawl.tk.struck
	as actor
		at point
			sound brawl_hit volume 2 pitch 0.8 jitter 0.1 range 50 m
