cbsheet 1

# reactions_grenade.tscn's reactions, as a rules sheet (CbRules: docs/looks.md, Rules sheets). Plain paths are
# from the scene's root.

# Thrown
react on grenade.thrown
	as actor
		at point
			sound jump volume -10 pitch 0.7 jitter 0.1 range 25

# Blast
react on grenade.blast
	as actor
		at point
			sound prop_destroy volume 2 pitch 0.55 jitter 0.08 range 80
			create grenade_blast for 2
			shake 0.25 for 0.35
