[gd_scene format=3]

; The pickup prompt. While the local player has something in reach ("pickup.target" is its NetId),
; prompt.tscn is added to that item ($local@pickup.target), and moves to the next one when that
; changes. The key shown is the one "pickup" is bound to now.

[node name="PickupReactions" type="Node3D"]

[node name="Prompt" type="CbReaction" parent="."]
when = 1
subject = NodePath("$local")
conditions = PackedStringArray("pickup.target")
scene = "res://vfx/prompt.tscn"
scene_parent = NodePath("$local@pickup.target")
