cbsheet 1

# reactions_pickup.tscn's reactions, as a rules sheet (CbRules: docs/looks.md, Rules sheets). Plain paths are
# from the scene's root.

# Prompt
react while pickup.target and pickup.hold == 0
	as local
		create prompt under local@pickup.target

# PromptHold
react while pickup.target and pickup.hold > 0
	as local
		create prompt_hold under local@pickup.target
