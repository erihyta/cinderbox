[gd_scene load_steps=8 format=3]

; The round HUD, laid over the game's when a server runs deathmatch. Fields and events only:
;   deathmatch.phase (0 playing, 1 between rounds), .seconds, .round, .kill_limit, .winner (a player),
;   deathmatch.score per player; deathmatch.ending, how the last round ended (0 none, 1 time ran
;   out, 2 flawless, 3 by a single point, 4 a clear win).
;   TeamWinner      in teams: which team won (deathmatch.winning_team; 0 a draw), in place of
;                   Winner and Nobody
;   Remark          the words for deathmatch.ending are here, not on the server: a CbFieldLabel
;                   whose choices are one line per number (line 0 empty: nothing to say). Reword
;                   or translate them freely.
;   Scores          the scoreboard, made of ordinary nodes: Key (a CbKey) keeps "ui.scores" at 1 while
;                   Tab is held and Shown (a CbFieldBinding) shows it while that holds; Header is plain Labels; Rows is a CbList of players whose child Row is one
;                   row as designed. In the game the list copies Row for every player, sorted, and
;                   the CbFieldLabels in a row read that player (is_local: the viewer's own row)
;                   In teams (the teams mod: team.id, M277) the players are listed by team: RedTitle
;                   and RedRows (where team.id == 1), BlueTitle and BlueRows (2), each title with its
;                   team's score (deathmatch.team_score_N), shown when the viewer is in a team; Rows
;                   lists those in none (a free-for-all: everyone). Teams are seen only here.

[sub_resource type="LabelSettings" id="Timer"]
font_size = 24
outline_size = 5
outline_color = Color(0, 0, 0, 0.8)

[sub_resource type="LabelSettings" id="Banner"]
font_size = 44
font_color = Color(1, 0.86, 0.35, 1)
outline_size = 8
outline_color = Color(0, 0, 0, 0.85)

[sub_resource type="LabelSettings" id="Small"]
font_size = 20
outline_size = 4
outline_color = Color(0, 0, 0, 0.8)

[sub_resource type="LabelSettings" id="Row"]
font_size = 20
outline_size = 4
outline_color = Color(0, 0, 0, 0.85)

[sub_resource type="LabelSettings" id="Red"]
font_size = 22
font_color = Color(1, 0.4, 0.35, 1)
outline_size = 5
outline_color = Color(0, 0, 0, 0.85)

[sub_resource type="LabelSettings" id="Blue"]
font_size = 22
font_color = Color(0.4, 0.65, 1, 1)
outline_size = 5
outline_color = Color(0, 0, 0, 0.85)

[sub_resource type="LabelSettings" id="RowLocal"]
font_size = 20
font_color = Color(1, 0.85, 0.35, 1)
outline_size = 4
outline_color = Color(0, 0, 0, 0.85)

[node name="DeathmatchHud" type="CanvasLayer"]

[node name="Round" type="CbFieldLabel" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -300.0
offset_top = 10.0
offset_right = 300.0
offset_bottom = 44.0
label_settings = SubResource("Timer")
horizontal_alignment = 1
text_format = "ROUND {deathmatch.round}   {deathmatch.seconds}s   FIRST TO {deathmatch.kill_limit}"
conditions = PackedStringArray("?deathmatch.phase", "deathmatch.phase == 0", "not team.id")

[node name="TeamRound" type="CbFieldLabel" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -300.0
offset_top = 10.0
offset_right = 300.0
offset_bottom = 44.0
label_settings = SubResource("Timer")
horizontal_alignment = 1
text_format = "ROUND {deathmatch.round}   {deathmatch.seconds}s   FIRST TEAM TO {deathmatch.team_kill_limit}"
conditions = PackedStringArray("?deathmatch.phase", "deathmatch.phase == 0", "team.id")

[node name="Score" type="CbFieldLabel" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -300.0
offset_top = 44.0
offset_right = 300.0
offset_bottom = 72.0
label_settings = SubResource("Small")
horizontal_alignment = 1
text_format = "your score {deathmatch.score}"
conditions = PackedStringArray("?deathmatch.score", "deathmatch.phase == 0")

[node name="Winner" type="CbFieldLabel" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -420.0
offset_top = 110.0
offset_right = 420.0
offset_bottom = 170.0
label_settings = SubResource("Banner")
horizontal_alignment = 1
text_format = "{name:deathmatch.winner} WINS ROUND {deathmatch.round}"
conditions = PackedStringArray("deathmatch.phase == 1", "deathmatch.winner", "not team.id")

[node name="Nobody" type="CbFieldLabel" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -420.0
offset_top = 110.0
offset_right = 420.0
offset_bottom = 170.0
label_settings = SubResource("Banner")
horizontal_alignment = 1
text = "NOBODY SCORED"
conditions = PackedStringArray("deathmatch.phase == 1", "!deathmatch.winner", "not team.id")

[node name="TeamWinner" type="CbFieldLabel" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -420.0
offset_top = 110.0
offset_right = 420.0
offset_bottom = 170.0
label_settings = SubResource("Banner")
horizontal_alignment = 1
conditions = PackedStringArray("deathmatch.phase == 1", "team.id")
choice_field = "deathmatch.winning_team"
choices = PackedStringArray("A DRAW", "RED WINS THE ROUND", "BLUE WINS THE ROUND")

[node name="Next" type="CbFieldLabel" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -300.0
offset_top = 172.0
offset_right = 300.0
offset_bottom = 204.0
label_settings = SubResource("Small")
horizontal_alignment = 1
text_format = "next round in {deathmatch.seconds}"
conditions = PackedStringArray("deathmatch.phase == 1")

[node name="Remark" type="CbFieldLabel" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -420.0
offset_top = 206.0
offset_right = 420.0
offset_bottom = 236.0
label_settings = SubResource("Small")
horizontal_alignment = 1
conditions = PackedStringArray("deathmatch.phase == 1")
choice_field = "deathmatch.ending"
choices = PackedStringArray("", "Time ran out", "A flawless round", "By a single point", "A clear win")

[node name="Scores" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -200.0
offset_right = 300.0
offset_bottom = 200.0

[node name="Key" type="CbKey" parent="Scores"]

[node name="Shown" type="CbFieldBinding" parent="Scores"]
conditions = PackedStringArray("ui.scores")

[node name="Header" type="HBoxContainer" parent="Scores"]

[node name="Player" type="Label" parent="Scores/Header"]
custom_minimum_size = Vector2(260, 0)
text = "Player"
label_settings = SubResource("Row")

[node name="Score" type="Label" parent="Scores/Header"]
custom_minimum_size = Vector2(110, 0)
text = "Score"
label_settings = SubResource("Row")

[node name="Kills" type="Label" parent="Scores/Header"]
custom_minimum_size = Vector2(110, 0)
text = "Kills"
label_settings = SubResource("Row")

[node name="Deaths" type="Label" parent="Scores/Header"]
custom_minimum_size = Vector2(110, 0)
text = "Deaths"
label_settings = SubResource("Row")

[node name="RedTitle" type="CbFieldLabel" parent="Scores"]
custom_minimum_size = Vector2(0, 34)
label_settings = SubResource("Red")
text_format = "RED   {deathmatch.team_score_1}"
conditions = PackedStringArray("team.id")

[node name="RedRows" type="CbList" parent="Scores"]
sort_by = "deathmatch.score"
where = PackedStringArray("team.id == 1")

[node name="Row" type="HBoxContainer" parent="Scores/RedRows"]

