cbsheet 1

# reactions_deathmatch.tscn's reactions, as a rules sheet (CbRules: docs/looks.md, Rules sheets). Plain paths are
# from the scene's root.

# RoundEnd
react on deathmatch.round_end
	as actor
		at point
			sound round_end volume -4

# YouWon
react on deathmatch.round_end if local
	as actor
		at point
			flash rgba(1, 0.85, 0.3, 0.35) for 1

# RoundStart
react on game.round_start
	as actor
		at point
			sound round_start volume -6
