; The combat mod's look: a workshop item players subscribe to. It contains no code; everything here
; is keyed on names the combat server mod declares ("combat.*").
; Publish it with: tools\publish_mod.ps1 -Mod combat

config_version=5

[application]

config/name="Cinderbox item: combat"
config/features=PackedStringArray("4.7", "Forward Plus")
