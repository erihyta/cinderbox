cbsheet 1

# reactions_combat.tscn's reactions, as a rules sheet (CbRules: docs/looks.md, Rules sheets). Plain paths are
# from the scene's root.

# Hurt
react on combat.hurt if local
	as actor
		at point
			flash rgba(0.8, 0.05, 0.05, 0.24) for 0.3

# Died
react on combat.killed if local
	as target
		at point
			flash rgba(0.6, 0, 0, 0.55) for 1.2
