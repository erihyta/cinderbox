[gd_scene load_steps=7 format=3]

; The combat mod's HUD, loaded over the game's own HUD when a server runs the combat mod: health,
; death, the kill feed and the scoreboard. Ordinary Godot controls driven by the mod's fields and
; events: no scripts. Restyle it freely, or override it from a player mod at res://ui/hud_combat.tscn.
;   CbFieldBinding  field -> a property of its target (default: its parent)
;   CbFieldLabel    "{field}" text, shown while its conditions hold
;   CbEventFeed     a line per mod event
;   Scores          the scoreboard, made of ordinary nodes: a CbShowKey shows it while "scores" (Tab) is
;                   held; Header is plain Labels; Rows is a CbList of players whose child Row is one
;                   row as designed. In the game the list copies Row for every player, sorted, and
;                   the CbFieldLabels in a row read that player (is_local: the viewer's own row)
;                   (it steps aside when a game mode brings its own: !?deathmatch.score)

[sub_resource type="StyleBoxFlat" id="BarBack"]
bg_color = Color(0.08, 0.08, 0.1, 0.65)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0, 0, 0, 0.8)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="BarFill"]
bg_color = Color(0.86, 0.2, 0.2, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="LabelSettings" id="Feed"]
font_size = 18
outline_size = 4
outline_color = Color(0, 0, 0, 0.8)

[sub_resource type="LabelSettings" id="Row"]
font_size = 20
outline_size = 4
outline_color = Color(0, 0, 0, 0.85)

[sub_resource type="LabelSettings" id="RowLocal"]
font_size = 20
font_color = Color(1, 0.85, 0.35, 1)
outline_size = 4
outline_color = Color(0, 0, 0, 0.85)

[sub_resource type="LabelSettings" id="BarText"]
font_size = 16
outline_size = 3
outline_color = Color(0, 0, 0, 0.8)

[node name="CombatHud" type="CanvasLayer"]

[node name="HealthBar" type="ProgressBar" parent="."]
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -284.0
offset_top = -112.0
offset_right = -24.0
offset_bottom = -84.0
theme_override_styles/background = SubResource("BarBack")
theme_override_styles/fill = SubResource("BarFill")
max_value = 100.0
value = 100.0
show_percentage = false

[node name="Value" type="CbFieldBinding" parent="HealthBar"]
field = "combat.health"
conditions = PackedStringArray("?combat.health", "!combat.dead")

[node name="Max" type="CbFieldBinding" parent="HealthBar"]
field = "combat.max_health"
property = "max_value"

[node name="Text" type="CbFieldLabel" parent="HealthBar"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
label_settings = SubResource("BarText")
horizontal_alignment = 1
vertical_alignment = 1
text_format = "{combat.health} / {combat.max_health}"

[node name="Low" type="CbFieldLabel" parent="."]
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -284.0
offset_top = -140.0
offset_right = -24.0
offset_bottom = -114.0
theme_override_colors/font_color = Color(0.95, 0.25, 0.25, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.8)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 16
horizontal_alignment = 2
text_format = "LOW  {combat.health * 100 / combat.max_health}%"
conditions = PackedStringArray("?combat.health and !combat.dead", "combat.health <= combat.max_health / 4")

[node name="Dead" type="CbFieldLabel" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -90.0
offset_right = 300.0
offset_bottom = -40.0
theme_override_colors/font_color = Color(0.95, 0.25, 0.25, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.8)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 40
horizontal_alignment = 1
text = "YOU DIED"
conditions = PackedStringArray("combat.dead")

[node name="Score" type="CbFieldLabel" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -284.0
offset_top = 12.0
offset_right = -24.0
offset_bottom = 40.0
label_settings = SubResource("Feed")
horizontal_alignment = 2
text_format = "Kills {combat.kills}   Deaths {combat.deaths}"
conditions = PackedStringArray("?combat.kills")

[node name="KillFeed" type="CbEventFeed" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -424.0
offset_top = 44.0
offset_right = -24.0
offset_bottom = 200.0
event = "combat.killed"
text_format = "{a}  >  {b}"
label_settings = SubResource("Feed")

[node name="Scores" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = -200.0
offset_right = 260.0
offset_bottom = 200.0

[node name="Key" type="CbShowKey" parent="Scores"]
conditions = PackedStringArray("!?deathmatch.score")

[node name="Header" type="HBoxContainer" parent="Scores"]

[node name="Player" type="Label" parent="Scores/Header"]
custom_minimum_size = Vector2(260, 0)
text = "Player"
label_settings = SubResource("Row")

[node name="Kills" type="Label" parent="Scores/Header"]
custom_minimum_size = Vector2(110, 0)
text = "Kills"
label_settings = SubResource("Row")

[node name="Deaths" type="Label" parent="Scores/Header"]
custom_minimum_size = Vector2(110, 0)
text = "Deaths"
label_settings = SubResource("Row")

[node name="Rows" type="CbList" parent="Scores"]
sort_by = "combat.kills"

[node name="Row" type="HBoxContainer" parent="Scores/Rows"]

[node name="Name" type="CbFieldLabel" parent="Scores/Rows/Row"]
custom_minimum_size = Vector2(260, 0)
label_settings = SubResource("Row")
text_format = "{name}"
conditions = PackedStringArray("not is_local")

[node name="NameLocal" type="CbFieldLabel" parent="Scores/Rows/Row"]
custom_minimum_size = Vector2(260, 0)
label_settings = SubResource("RowLocal")
text_format = "{name}"
conditions = PackedStringArray("is_local")

[node name="Kills" type="CbFieldLabel" parent="Scores/Rows/Row"]
custom_minimum_size = Vector2(110, 0)
label_settings = SubResource("Row")
text_format = "{combat.kills}"

[node name="Deaths" type="CbFieldLabel" parent="Scores/Rows/Row"]
custom_minimum_size = Vector2(110, 0)
label_settings = SubResource("Row")
text_format = "{combat.deaths}"
