[gd_scene format=3]

; A cannon ball: iron, 15 cm across, 8 kg; fast, so the simulation traces it (bullet) and it never
; passes through a thin wall between two ticks. The cannon launches it (prefabs/cannon.tscn); what
; it does when it hits is the cannon mod's. Not for a slot, and not for picking up (the mod says so).
; Saving this scene bakes it into res://items/cannon.ball.cfg.

[sub_resource type="SphereShape3D" id="Body"]
radius = 0.075

[sub_resource type="StandardMaterial3D" id="Iron"]
albedo_color = Color(0.12, 0.12, 0.13, 1)
metallic = 0.8
roughness = 0.35

[sub_resource type="SphereMesh" id="Ball"]
material = SubResource("Iron")
radius = 0.075
height = 0.15
radial_segments = 16
rings = 8

[node name="Ball" type="CbItem"]
kind = "cannon.ball"
display_name = "Cannon ball"
bullet = true
mass = 8.0
friction = 0.6
bounce = 0.15

[node name="Body" type="CollisionShape3D" parent="."]
shape = SubResource("Body")

[node name="Mesh" type="MeshInstance3D" parent="."]
mesh = SubResource("Ball")
