characters/*/client/.godot/
characters/*/client/bin/
characters/*/client/cinderbox.gdextension
characters/*/client/cinderbox.gdextension.uid

# The SDK's parts of a project (tools\sdk.ps1 copies them in): the extension, and in a mod's
