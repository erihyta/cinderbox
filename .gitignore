sdk/.godot/
sdk/anim/
sdk/items/
sdk/bin/
sdk/cinderbox.gdextension
sdk/cinderbox.gdextension.uid
server_mods/*/client/placeholder/

# Paid assets: never on GitHub (the repo is public). Keep the purchased packs here, outside git.
Universal Animation Library*/
/paid/
# The rifle (a gun of the gun mod's look, made with licensed animations): its scene, pack, effects
# and sounds are local only. The gun mod is in the repository with the pistol; a checkout without
# these has no rifle. The gun mod's published item names what is in it, so it is local too.
server_mods/gun/client/prefabs/rifle.tscn
server_mods/gun/client/animation_packs/rifle_hold.tscn
server_mods/gun/client/animation_packs/source/*ifle*
server_mods/gun/client/animation_packs/source/idle.fbx*
server_mods/gun/client/vfx/rifle_*
server_mods/gun/client/assets/sfx/rifle_*
server_mods/gun/client/anim/gun.rifle_hold/
server_mods/gun/client/items/gun.rifle.cfg
server_mods/gun/client_item.cfg
# The character built from the paid Source pack (its glb, scene, baked clips): local only.
godot/characters/ual_mannequin/

# Personal notes vault
.obsidian/

# What the mods declare, written by the server's build for the editor
cinderbox_names.cfg

# repomix packs of the repository (.repomixignore says what they leave out)
repomix-output.*
