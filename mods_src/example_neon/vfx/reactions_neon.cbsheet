cbsheet 1

# reactions_neon.tscn's reactions, as a rules sheet (CbRules: docs/looks.md, Rules sheets). Plain paths are
# from the scene's root.

# LocalLand
react on landed if actor is player and local
	as actor
		at point offset 0 0.1 0
			sound neon_blip volume -14 jitter 0.25
			create prop_spawn for 2

# CrateBreak
react on destroying if actor is heavy_crate
	as actor
		at point
			create prop_spawn for 3

# SpawnFlash
react on spawned if actor is prop and local
	cooldown 0.4
	as actor
		at point
			flash rgba(1, 0.2, 0.8, 0.12) for 0.12
