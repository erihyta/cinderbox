+// Padding bytes, and the bytes of a union past its active member, are never read. They hold whatever
+// the memory held before, and struct copies from stack temporaries carry stack contents into them. The
+// images written below zero them, so a snapshot depends only on the simulation state: two saves of
+// the same state are byte-identical, and no stale process memory leaves the machine.
+static void b3ZeroBytes( void* p, size_t from, size_t to )
+{
+	if ( to > from )
+	{
+		memset( (char*)p + from, 0, to - from );
+	}
+}
+
+#define B3_FIELD_END( type, field ) ( offsetof( type, field ) + sizeof( ( (type*)0 )->field ) )
+#define B3_ZERO_BETWEEN( p, type, a, b ) b3ZeroBytes( ( p ), B3_FIELD_END( type, a ), offsetof( type, b ) )
+#define B3_ZERO_TAIL( p, type, last ) b3ZeroBytes( ( p ), B3_FIELD_END( type, last ), sizeof( type ) )
+
+static void b3ScrubFilter( b3Filter* f )
+{
+	B3_ZERO_TAIL( f, b3Filter, groupIndex );
+}
+
+static void b3ScrubShape( b3Shape* s )
+{
+	b3ScrubFilter( &s->filter );
+	B3_ZERO_BETWEEN( s, b3Shape, flags, capsule );
+
+	// The geometry follows the struct image and is restored from there (hulls, meshes, height fields
+	// and compounds through the registry), so the union in the image is never read. Its hull, mesh,
+	// height field or compound pointer would reveal a heap address. The union is the last member:
+	// this also clears the tail padding.
+	b3ZeroBytes( s, offsetof( b3Shape, capsule ), sizeof( b3Shape ) );
+}
+
+static void b3ScrubBody( b3Body* b )
+{
+	B3_ZERO_TAIL( b, b3Body, generation );
+}
+
+static void b3ScrubJoint( b3Joint* j )
+{
+	B3_ZERO_TAIL( j, b3Joint, collideConnected );
+}
+
+static void b3ScrubContact( b3Contact* c )
+{
+	B3_ZERO_BETWEEN( c, b3Contact, friction, convexContact );
+	size_t active;
+	if ( c->flags & b3_simMeshContact )
+	{
+		active = sizeof( b3MeshContact );
+	}
+	else
+	{
+		// The cache is a union; the simplex cache is its larger member.
+		_Static_assert( sizeof( b3SATCache ) <= sizeof( b3SimplexCache ), "simplex cache is the larger member" );
+		b3ZeroBytes( &c->convexContact, sizeof( b3SimplexCache ), sizeof( b3ConvexContact ) );
+		active = sizeof( b3ConvexContact );
+	}
+	b3ZeroBytes( c, offsetof( b3Contact, convexContact ) + active, offsetof( b3Contact, restitution ) );
+	B3_ZERO_TAIL( c, b3Contact, generation );
+}
+
+static void b3ScrubManifold( b3Manifold* m )
+{
+	for ( int i = 0; i < (int)( sizeof( m->points ) / sizeof( m->points[0] ) ); ++i )
+	{
+		B3_ZERO_TAIL( m->points + i, b3ManifoldPoint, persisted );
+	}
+}
+
+static void b3ScrubJointSim( b3JointSim* j )
+{
+	B3_ZERO_BETWEEN( j, b3JointSim, fixedRotation, distanceJoint );
+
+	size_t active = 0;
+	switch ( j->type )
+	{
+		case b3_distanceJoint:
+			B3_ZERO_TAIL( &j->distanceJoint, b3DistanceJoint, enableMotor );
+			active = sizeof( b3DistanceJoint );
+			break;
+		case b3_motorJoint:
+			active = sizeof( b3MotorJoint );
+			break;
+		case b3_parallelJoint:
+			active = sizeof( b3ParallelJoint );
+			break;
+		case b3_prismaticJoint:
+			B3_ZERO_TAIL( &j->prismaticJoint, b3PrismaticJoint, enableMotor );
+			active = sizeof( b3PrismaticJoint );
+			break;
+		case b3_revoluteJoint:
+			B3_ZERO_TAIL( &j->revoluteJoint, b3RevoluteJoint, enableLimit );
+			active = sizeof( b3RevoluteJoint );
+			break;
+		case b3_sphericalJoint:
+			active = sizeof( b3SphericalJoint );
+			break;
+		case b3_weldJoint:
+			active = sizeof( b3WeldJoint );
+			break;
+		case b3_wheelJoint:
+			B3_ZERO_TAIL( &j->wheelJoint, b3WheelJoint, enableSteeringMotor );
+			active = sizeof( b3WheelJoint );
+			break;
+		default:
+			break;
+	}
+	// The union is the last member: this also clears the tail padding.
+	b3ZeroBytes( j, offsetof( b3JointSim, distanceJoint ) + active, sizeof( b3JointSim ) );
+}
+
+static void b3ScrubContactSpec( b3ContactSpec* s )
+{
+	B3_ZERO_TAIL( s, b3ContactSpec, manifoldCount );
+}
+
+static void b3ScrubVisitor( b3Visitor* v )
+{
+	B3_ZERO_TAIL( v, b3Visitor, generation );
+}
+
+static void b3ScrubSetItem( b3SetItem* item )
+{
+	B3_ZERO_TAIL( item, b3SetItem, hash );
+}
+
+// A POD array whose elements have padding: count + scrubbed copies of the elements
+#define b3SerScrubbedArray( buf, arr, type, scrub )                                                                               \
+	do                                                                                                                           \
+	{                                                                                                                            \
+		b3SnapW_I32( buf, ( arr ).count );                                                                                       \
+		for ( int k_ = 0; k_ < ( arr ).count; ++k_ )                                                                             \
+		{                                                                                                                        \
+			type copy_;                                                                                                          \
+			memcpy( &copy_, ( arr ).data + k_, sizeof( type ) );                                                                 \
+			scrub( &copy_ );                                                                                                     \
+			b3SnapW_Bytes( buf, &copy_, (int)sizeof( type ) );                                                                   \
+		}                                                                                                                        \
+	}                                                                                                                            \
+	while ( 0 )
+
