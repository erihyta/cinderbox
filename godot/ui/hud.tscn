[gd_scene format=3]

; The game's own HUD: engine information only. Stats, Banner and Help are filled by game.gd. (The
; player's name and the server are chosen in the menu, res://ui/menu.tscn.)
; A server mod's HUD comes with its workshop item as res://ui/hud_<mod>.tscn and is laid over this.

[node name="Hud" type="CanvasLayer"]

[node name="Stats" type="Label" parent="."]
unique_name_in_owner = true
offset_left = 12.0
offset_top = 10.0
offset_right = 700.0
offset_bottom = 160.0
theme_override_colors/font_color = Color(0.05, 0.05, 0.08, 1)
theme_override_font_sizes/font_size = 16

[node name="Help" type="Label" parent="."]
unique_name_in_owner = true
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = -62.0
offset_right = -12.0
offset_bottom = -10.0
grow_vertical = 0
theme_override_colors/font_color = Color(0.2, 0.2, 0.25, 1)
vertical_alignment = 2
autowrap_mode = 3
text = "WASD move   Shift sprint   Space jump   Tab scores   Mouse orbit   Wheel zoom   Esc menu   F1 stats"

[node name="Banner" type="Label" parent="."]
unique_name_in_owner = true
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -420.0
offset_top = -20.0
offset_right = 420.0
offset_bottom = 120.0
theme_override_colors/font_color = Color(1, 0.55, 0.1, 1)
theme_override_font_sizes/font_size = 24
horizontal_alignment = 1
autowrap_mode = 3
text = "Connecting..."
