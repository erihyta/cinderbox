[gd_scene format=3]

; The HUD. Stats, Banner and Help are filled by game.gd. The CbFieldLabel nodes read the server
; mods' fields by name and show only while their conditions hold, so a server without the pistol
; mod simply shows none of them ("?name" means the field is declared).

[node name="Hud" type="CanvasLayer"]

[node name="Stats" type="Label" parent="."]
unique_name_in_owner = true
offset_left = 12.0
offset_top = 10.0
offset_right = 700.0
offset_bottom = 160.0
theme_override_colors/font_color = Color(0.05, 0.05, 0.08, 1)
theme_override_font_sizes/font_size = 16

[node name="Help" type="Label" parent="."]
unique_name_in_owner = true
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = -34.0
offset_right = 1200.0
offset_bottom = -10.0
theme_override_colors/font_color = Color(0.2, 0.2, 0.25, 1)
text = "WASD move   Shift sprint   Space jump   Mouse orbit   Wheel zoom   Esc cursor   F1 stats"

[node name="Banner" type="Label" parent="."]
unique_name_in_owner = true
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -20.0
offset_right = 300.0
offset_bottom = 20.0
theme_override_colors/font_color = Color(1, 0.55, 0.1, 1)
theme_override_font_sizes/font_size = 26
horizontal_alignment = 1
text = "Connecting..."

[node name="Crosshair" type="CbFieldLabel" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -20.0
offset_top = -20.0
offset_right = 20.0
offset_bottom = 20.0
theme_override_colors/font_color = Color(1, 1, 1, 0.9)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.8)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 26
horizontal_alignment = 1
vertical_alignment = 1
text = "+"
conditions = PackedStringArray("loadout.slot == 2", "!combat.dead")

[node name="Health" type="CbFieldLabel" parent="."]
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -260.0
offset_top = -110.0
offset_right = -24.0
offset_bottom = -76.0
theme_override_colors/font_color = Color(0.95, 0.3, 0.3, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.7)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 26
horizontal_alignment = 2
text_format = "HP {combat.health}"
conditions = PackedStringArray("?combat.health", "!combat.dead")

[node name="Ammo" type="CbFieldLabel" parent="."]
