[gd_scene format=3]

; The game's own reactions to the world: spawns, jumps, landings, footsteps, impacts. Loaded once
; (like every res://vfx/reactions*.tscn), so these CbReaction nodes have no entity of their own:
; each names what it is about from the cue ($at). A mod adds its own
; reactions_<name>.tscn, or replaces this file to change the game's.

[node name="GameReactions" type="Node3D"]

[node name="PropSpawn" type="CbReaction" parent="."]
event = "spawned"
subject = NodePath("$at")
subject_kind = "prop"
scene = "res://vfx/prop_spawn.tscn"
scene_lifetime = 3.0
place = 1
sound = "res://assets/sfx/prop_spawn.wav"
volume_db = -8.0
pitch_jitter = 0.15
max_distance = 40.0
cooldown = 0.05

[node name="PropDestroy" type="CbReaction" parent="."]
event = "destroying"
subject = NodePath("$at")
subject_kind = "prop"
scene = "res://vfx/prop_destroy.tscn"
scene_lifetime = 3.0
place = 1
sound = "res://assets/sfx/prop_destroy.wav"
volume_db = -12.0
pitch_jitter = 0.2
max_distance = 35.0
cooldown = 0.08

[node name="Jump" type="CbReaction" parent="."]
event = "jumped"
subject = NodePath("$at")
subject_kind = "player"
scene = "res://vfx/jump.tscn"
scene_lifetime = 2.0
place = 1
sound = "res://assets/sfx/jump.wav"
volume_db = -14.0
pitch_jitter = 0.1
max_distance = 25.0

[node name="Land" type="CbReaction" parent="."]
event = "landed"
subject = NodePath("$at")
subject_kind = "player"
scene = "res://vfx/land.tscn"
scene_lifetime = 2.0
place = 1
sound = "res://assets/sfx/land.wav"
volume_db = -10.0
pitch_jitter = 0.12
max_distance = 30.0

[node name="BouncyTrail" type="CbReaction" parent="."]
event = "spawned"
subject = NodePath("$at")
subject_template = "bouncy_ball"
scene = "res://vfx/bouncy_trail.tscn"
scene_lifetime = 25.0
place = 5

[node name="Footstep" type="CbReaction" parent="."]
event = "footstep"
subject = NodePath("$at")
subject_kind = "player"
place = 1
sound = "res://assets/sfx/footstep.wav"
volume_db = -20.0
pitch_jitter = 0.18
max_distance = 18.0

[node name="Impact" type="CbReaction" parent="."]
event = "impact"
subject = NodePath("$at")
conditions = PackedStringArray("event.strength >= 2.5")
place = 1
sound = "res://assets/sfx/impact.wav"
volume_db = -18.0
pitch_jitter = 0.25
max_distance = 30.0
cooldown = 0.03

[node name="HardImpact" type="CbReaction" parent="."]
event = "impact"
subject = NodePath("$at")
conditions = PackedStringArray("event.strength >= 8.0")
scene = "res://vfx/prop_destroy.tscn"
scene_lifetime = 1.5
place = 1
cooldown = 0.1
