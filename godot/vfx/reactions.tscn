[gd_scene format=3]

; The game's own reactions to the world: spawns, jumps, landings, footsteps, impacts. Loaded once
; (like every res://vfx/reactions*.tscn), so these reactions have no entity of their own: each
; names what it is about from the cue ($at). They are the rules sheet beside it (reactions.rules).
; A mod adds its own reactions_<name>.tscn, or replaces this file to change the game's.

[node name="GameReactions" type="Node3D"]

[node name="Rules" type="CbRules" parent="."]
file = "res://vfx/reactions.rules"
