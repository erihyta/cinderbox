[gd_resource type="CbEffectTable" load_steps=7 format=3]

; What plays when. Mods add their own res://vfx/bindings_<name>.tres instead of replacing this one.
;   event:         0 spawned, 1 destroying, 2 jumped, 3 landed
;   template_name: "" matches any map template
;   kind:          "" or "any", or "prop" / "player" / "static"
;   who:           0 anyone, 1 the local player, 2 other players
; A binding can carry a scene, a sound, a screen effect, or any combination of them.

[sub_resource type="CbEffect" id="PropSpawn"]
event = 0
kind = "prop"
scene = "res://vfx/prop_spawn.tscn"
lifetime = 3.0
sound = "res://assets/sfx/prop_spawn.wav"
volume_db = -8.0
pitch_jitter = 0.15
max_distance = 40.0
cooldown = 0.05

