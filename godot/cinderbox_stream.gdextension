[configuration]

entry_symbol = "cinderbox_stream_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://bin/libcinderbox_stream.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libcinderbox_stream.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libcinderbox_stream.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libcinderbox_stream.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libcinderbox_stream.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libcinderbox_stream.linux.template_release.arm64.so"
macos.debug = "res://bin/libcinderbox_stream.macos.template_debug.dylib"
macos.release = "res://bin/libcinderbox_stream.macos.template_release.dylib"
