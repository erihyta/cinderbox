[configuration]

entry_symbol = "cinderbox_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://bin/libcinderbox.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libcinderbox.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libcinderbox.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libcinderbox.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libcinderbox.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libcinderbox.linux.template_release.arm64.so"
macos.debug = "res://bin/libcinderbox.macos.template_debug.dylib"
macos.release = "res://bin/libcinderbox.macos.template_release.dylib"
