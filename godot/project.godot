; Engine configuration file. Godot rewrites this file, so keep notes short.
; Cinderbox Godot client: presentation only. The simulation, prediction and networking run inside
; the Cinderbox GDExtension (src/godot), which mirrors the game into this scene tree.

config_version=5

[application]

config/name="Cinderbox"
config/description="Cinderbox client (Godot presentation layer)"
run/main_scene="res://boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/cinderbox_maps/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Cinderbox"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
